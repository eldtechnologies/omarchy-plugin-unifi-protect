#!/usr/bin/env python3
"""UniFi Protect helper for the Omarchy shell.

The shell never speaks HTTP or holds the API key. This CLI does both, writes
camera state and snapshots to disk for the panel to watch, and resolves
RTSPS stream URLs on demand.

Uses the official Protect Integration API (/proxy/protect/integration/v1)
authenticated with a console API key (X-API-KEY).
"""

import argparse
import base64
import asyncio
import fcntl
import getpass
import hashlib
import hmac
import http.client
import json
import os
import random
import re
import secrets
import shutil
import signal
import socket
import stat
import struct
import unicodedata
import ssl
import subprocess
import sys
import threading
import time
import urllib.parse
from concurrent.futures import ThreadPoolExecutor

API_BASE = "/proxy/protect/integration/v1"

HOME = os.path.expanduser("~")
CONFIG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config"), "eld-unifi-protect")
CONFIG_PATH = os.path.join(CONFIG_DIR, "config.json")
STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local", "state"), "eld-unifi-protect")
STATE_PATH = os.path.join(STATE_DIR, "state.json")
# Snapshots are disposable and rewritten every few seconds: keep them in
# tmpfs so they never wear the disk or survive a reboot.
# Snapshots, stream URLs and the relay's token live here. It must be the
# per-user, owner-only runtime directory: never a shared fallback such as
# /tmp, where another user could plant files or symlinks ahead of us.
# check_runtime_dir() enforces that before any command runs.
RUNTIME_BASE = os.environ.get("XDG_RUNTIME_DIR") or ""
RUNTIME_DIR = os.path.join(RUNTIME_BASE, "eld-unifi-protect") if RUNTIME_BASE else ""
SNAP_DIR = os.path.join(RUNTIME_DIR, "snapshots")
SNAP_INDEX = os.path.join(SNAP_DIR, "index.json")

QUALITIES = ("high", "medium", "low")
PLUGIN_DIR = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))



def plugin_version():
    """The version lives in manifest.json alone, so the two never drift."""
    manifest = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "manifest.json")
    try:
        with open(manifest) as handle:
            return json.load(handle).get("version", "unknown")
    except (OSError, ValueError):
        return "unknown"


class ProtectError(Exception):
    pass


# ---- files ---------------------------------------------------------------


def write_atomic(path, data, mode=0o600):
    directory = os.path.dirname(path)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    # Unique per call, not per process: the wall resolves streams from
    # several threads, and a shared temp name let one thread rename the
    # other's file away.
    tmp = f"{path}.tmp.{os.getpid()}.{secrets.token_hex(4)}"
    with open(tmp, "wb") as handle:
        handle.write(data if isinstance(data, bytes) else data.encode())
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def write_json(path, value):
    write_atomic(path, json.dumps(value, indent=2) + "\n")


def slugify(text):
    slug = "".join(ch if ch.isalnum() else "-" for ch in text.lower()).strip("-")
    while "--" in slug:
        slug = slug.replace("--", "-")
    return slug or "console"


# ---- API key storage ---------------------------------------------------------
#
# Keys go to the desktop keyring (Secret Service, via secret-tool) when one is
# available: encrypted at rest and locked with the session. config.json then
# only records "keyStore": "keyring" for that console. Without a keyring, the
# key stays in config.json, which is readable only by the user.
#
# The key always travels to and from secret-tool on stdin/stdout, never as a
# command-line argument, which any local user could read.

KEYRING_SERVICE = "eld-unifi-protect"
_key_cache = {}


class KeyringUnavailable(Exception):
    pass


def _secret_tool(args, secret=None):
    tool = shutil.which("secret-tool")
    if not tool:
        raise KeyringUnavailable("secret-tool is not installed (package libsecret)")
    try:
        result = subprocess.run([tool, *args], input=secret, capture_output=True,
                                text=True, timeout=10)
    except subprocess.TimeoutExpired:
        raise KeyringUnavailable("the keyring did not answer; is it locked?")
    # Exit 1 with nothing on stderr means "no such item"; anything on stderr
    # means the Secret Service itself could not be reached.
    if result.returncode != 0 and result.stderr.strip():
        raise KeyringUnavailable(result.stderr.strip().splitlines()[-1])
    return result


def keyring_available():
    try:
        _secret_tool(["lookup", "service", KEYRING_SERVICE, "console", "__probe__"])
        return True
    except KeyringUnavailable:
        return False


def keyring_store(console_id, label, key):
    result = _secret_tool(["store", f"--label={label}", "service", KEYRING_SERVICE,
                           "console", console_id], secret=key)
    if result.returncode != 0:
        raise KeyringUnavailable("the keyring refused to store the key")
    _key_cache[console_id] = key


def keyring_lookup(console_id):
    if console_id not in _key_cache:
        result = _secret_tool(["lookup", "service", KEYRING_SERVICE, "console", console_id])
        _key_cache[console_id] = result.stdout if result.returncode == 0 else ""
    return _key_cache[console_id]


def keyring_clear(console_id):
    _key_cache.pop(console_id, None)
    _secret_tool(["clear", "service", KEYRING_SERVICE, "console", console_id])


def resolve_keys(config):
    """Fill in apiKey for keyring consoles; record why when it cannot."""
    for console in config["consoles"]:
        if console.get("keyStore") != "keyring":
            continue
        try:
            console["apiKey"] = keyring_lookup(console["id"])
            if not console["apiKey"]:
                console["keyError"] = ("API key missing from the keyring; "
                                       "run `eld-unifi-protect setup` for this console")
        except KeyringUnavailable as error:
            console["apiKey"] = ""
            console["keyError"] = f"cannot read the API key from the keyring: {error}"


def store_key(config, console, key):
    """Put a console's key in the keyring if possible, else in the file."""
    try:
        keyring_store(console["id"], f"UniFi Protect API key ({console['name']}, {console['host']})", key)
        console["keyStore"] = "keyring"
        console["apiKey"] = key
        return "keyring"
    except KeyringUnavailable:
        console.pop("keyStore", None)
        console["apiKey"] = key
        return "file"


def load_config():
    """Return {"consoles": [...], "timeoutSec": n}, or None when unconfigured.

    Each UniFi console runs its own Protect with its own API key, so the
    config is a list. The original single-console shape is still read and
    converted on the next save.
    """
    if demo_on():
        return demo_config()
    try:
        with open(CONFIG_PATH) as handle:
            config = json.load(handle)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as error:
        raise ProtectError(f"cannot read {CONFIG_PATH}: {error}")
    if "consoles" not in config and config.get("host"):
        config = {
            "consoles": [{
                "id": slugify(config["host"]),
                "name": config["host"],
                "host": config["host"],
                "apiKey": config.get("apiKey", ""),
                "certSha256": config.get("certSha256"),
            }],
            "timeoutSec": config.get("timeoutSec", 8),
        }
    config["consoles"] = [c for c in config.get("consoles", [])
                          if c.get("host") and (c.get("apiKey") or c.get("keyStore") == "keyring")]
    if not config["consoles"]:
        return None
    resolve_keys(config)
    return config


def save_config(config):
    """Write the config; keys held by the keyring are never written out."""
    if demo_on():
        raise ProtectError("demo mode is on; run `eld-unifi-protect demo off` first")
    stored = dict(config, consoles=[])
    for console in config["consoles"]:
        entry = {k: v for k, v in console.items() if k != "keyError"}
        if entry.get("keyStore") == "keyring":
            entry.pop("apiKey", None)
        stored["consoles"].append(entry)
    write_json(CONFIG_PATH, stored)
    os.chmod(CONFIG_DIR, 0o700)


def require_config():
    config = load_config()
    if config is None:
        raise ProtectError("not set up yet: run `eld-unifi-protect setup`")
    return config


def find_console(config, name):
    """Match a console by id, name or host; None picks the only one."""
    consoles = config["consoles"]
    if name is None:
        if len(consoles) == 1:
            return consoles[0]
        raise ProtectError("several consoles configured; name one: "
                           + ", ".join(c["name"] for c in consoles))
    wanted = name.lower()
    for console in consoles:
        if wanted in (console["id"], console["name"].lower(), console["host"].lower()):
            return console
    raise ProtectError(f"no console named {name!r}")


def resolve_camera(config, uid):
    """Split a "<console>_<camera>" uid into (Protect client, camera id)."""
    console_id, sep, camera_id = uid.partition("_")
    if sep:
        for console in config["consoles"]:
            if console["id"] == console_id:
                return Protect(console, config), camera_id
    # A bare camera id (older panels, scripts written by hand): find the
    # console that last listed it, preferring one where it is connected.
    listed = [c for c in previous_state().get("cameras", []) if c.get("id") == uid]
    listed.sort(key=lambda c: not c.get("online"))
    for camera in listed:
        for console in config["consoles"]:
            if console["id"] == camera.get("console"):
                return Protect(console, config), uid
    if len(config["consoles"]) == 1:
        return Protect(config["consoles"][0], config), uid
    raise ProtectError(f"no camera {uid!r} on any console; see `eld-unifi-protect cameras`")


# ---- TLS -----------------------------------------------------------------
#
# Consoles ship self-signed certificates. Rather than turning verification
# off, setup pins the SHA-256 of the certificate the console presents, and
# every connection checks the pin during the handshake, before the API key
# is written to the socket.


def split_host(host):
    host = host.strip().removeprefix("https://").removeprefix("http://").rstrip("/")
    if host.startswith("["):
        name, _, port = host[1:].partition("]")
        return name, int(port.lstrip(":") or 443)
    if host.count(":") == 1:
        name, port = host.split(":")
        return name, int(port)
    return host, 443


def fetch_cert_fingerprint(host, timeout=8):
    name, port = split_host(host)
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    with socket.create_connection((name, port), timeout=timeout) as sock:
        with context.wrap_socket(sock, server_hostname=name) as tls:
            der = tls.getpeercert(binary_form=True)
    return hashlib.sha256(der).hexdigest()


class PinnedHTTPSConnection(http.client.HTTPSConnection):
    def __init__(self, host, port, pin, timeout):
        context = ssl.create_default_context()
        if pin:
            context.check_hostname = False
            context.verify_mode = ssl.CERT_NONE
        super().__init__(host, port, timeout=timeout, context=context)
        self._pin = pin

    def connect(self):
        super().connect()
        if self._pin:
            der = self.sock.getpeercert(binary_form=True)
            if hashlib.sha256(der).hexdigest() != self._pin:
                self.sock.close()
                raise ProtectError(
                    "console certificate changed; if expected, run `eld-unifi-protect trust-cert`"
                )


# ---- API -----------------------------------------------------------------


STREAM_CACHE = os.path.join(RUNTIME_DIR, "streams.json")
STREAM_CACHE_LOCK = threading.Lock()


def load_stream_cache():
    try:
        with open(STREAM_CACHE) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


# ---- stream relay ----------------------------------------------------------
#
# Protect serves camera video as RTSPS on port 7441 behind its self-signed
# certificate. FFmpeg 9 (inside both QtMultimedia and mpv) refuses unverified
# TLS, and neither player can be handed the certificate we pinned. So players
# connect to this relay over loopback, and the relay carries the stream to the
# console over TLS, checking the same pinned certificate as the API does:
#
#   player --plain RTSP, 127.0.0.1 only--> relay --TLS, pinned--> console:7441
#
# Nothing unencrypted leaves the machine. The relay forces RTSP-over-TCP
# (interleaved), so media never travels as separate UDP outside the tunnel,
# and every URL carries a random token so other local users cannot use it.

RELAY_INFO = os.path.join(RUNTIME_DIR, "relay.json")
RELAY_LOCK = os.path.join(RUNTIME_DIR, "relay.lock")
RELAY_IDLE_EXIT = 60
STREAM_PORT = 7441


def read_relay_info():
    try:
        with open(RELAY_INFO) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def relay_alive(info):
    if not info.get("port"):
        return False
    try:
        with socket.create_connection(("127.0.0.1", info["port"]), timeout=0.5):
            return True
    except OSError:
        return False


RELAY_START_LOCK = threading.Lock()


def ensure_relay():
    """Return the running relay's info, starting the relay if needed."""
    with RELAY_START_LOCK:
        return _ensure_relay()


def _ensure_relay():
    info = read_relay_info()
    if info.get("pid") and relay_alive(info):
        return info
    subprocess.Popen(
        [sys.executable, "-I", os.path.realpath(__file__), "relay"],
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    deadline = time.monotonic() + 5
    while time.monotonic() < deadline:
        time.sleep(0.05)
        fresh = read_relay_info()
        if fresh.get("pid") != info.get("pid") and relay_alive(fresh):
            return fresh
    raise ProtectError("the stream relay did not start; run `eld-unifi-protect relay` to see why")


def relay_url(console_id, rtsps_url):
    """The loopback URL a player opens for one of Protect's RTSPS URLs."""
    info = ensure_relay()
    path = urllib.parse.urlsplit(rtsps_url).path
    return f"rtsp://127.0.0.1:{info['port']}/{info['token']}/{console_id}{path}"


def read_exact(reader, count):
    data = reader.read(count)
    return data if len(data) == count else None


def read_rtsp(reader):
    """One RTSP message or interleaved frame, or None at end of stream.

    Returns ("frame", raw_bytes) for $-framed media, which is passed through
    untouched, or ("text", start_line, headers, body) for requests and
    responses, which may need their URLs rewritten.
    """
    first = reader.read(1)
    if not first:
        return None
    if first == b"$":
        header = read_exact(reader, 3)
        if header is None:
            return None
        payload = read_exact(reader, int.from_bytes(header[1:3], "big"))
        if payload is None:
            return None
        return ("frame", first + header + payload)
    line = first + reader.readline(8192)
    start = line.decode("latin-1").rstrip("\r\n")
    headers = []
    while True:
        line = reader.readline(8192)
        if not line:
            return None
        line = line.decode("latin-1").rstrip("\r\n")
        if not line:
            break
        name, _, value = line.partition(":")
        headers.append((name.strip(), value.strip()))
    length = 0
    for name, value in headers:
        if name.lower() == "content-length":
            length = int(value or 0)
    body = read_exact(reader, length) if length else b""
    if body is None:
        return None
    return ("text", start, headers, body)


def header_value(headers, wanted):
    for name, value in headers:
        if name.lower() == wanted:
            return value
    return ""


def encode_rtsp(start, headers, body):
    lines = [start]
    for name, value in headers:
        if name.lower() != "content-length":
            lines.append(f"{name}: {value}")
    if body:
        lines.append(f"Content-Length: {len(body)}")
    return ("\r\n".join(lines) + "\r\n\r\n").encode("latin-1") + body


async def read_rtsp_async(reader):
    """read_rtsp() for an asyncio StreamReader; None at end of stream."""
    try:
        first = await reader.readexactly(1)
        if first == b"$":
            header = await reader.readexactly(3)
            payload = await reader.readexactly(int.from_bytes(header[1:3], "big"))
            return ("frame", first + header + payload)
        start = (first + await reader.readuntil(b"\n")).decode("latin-1").rstrip("\r\n")
        headers = []
        while True:
            line = (await reader.readuntil(b"\n")).decode("latin-1").rstrip("\r\n")
            if not line:
                break
            name, _, value = line.partition(":")
            headers.append((name.strip(), value.strip()))
        length = int(header_value(headers, "content-length") or 0)
        body = await reader.readexactly(length) if length else b""
        return ("text", start, headers, body)
    except (asyncio.IncompleteReadError, asyncio.LimitOverrunError, ConnectionError, ValueError):
        return None


class RelaySession:
    """One player connection, tunnelled to one console over pinned TLS.

    Both directions run as coroutines on the relay's single event loop.
    That is a correctness requirement, not a style choice: OpenSSL forbids
    using one TLS connection from two threads at once, and the earlier
    thread-per-direction design read and wrote it concurrently, which could
    hang or crash the relay.
    """

    def __init__(self, relay, reader, writer):
        self.relay = relay
        self.client_reader = reader
        self.client_writer = writer
        self.upstream_reader = None
        self.upstream_writer = None
        self.pump = None
        self.console = None
        self.local_base = ""
        self.remote_base = ""

    async def reply(self, code, reason, cseq):
        self.client_writer.write(f"RTSP/1.0 {code} {reason}\r\nCSeq: {cseq}\r\n\r\n".encode())
        await self.client_writer.drain()

    def route(self, url):
        """Check the token and find the console a request URL names."""
        parts = urllib.parse.urlsplit(url).path.split("/")
        if len(parts) < 3 or not hmac.compare_digest(parts[1], self.relay.token):
            return None
        return self.relay.consoles.get(parts[2])

    async def connect(self, console):
        name, _ = split_host(console["host"])
        context = ssl.create_default_context()
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(name, STREAM_PORT, ssl=context, server_hostname=name), 8)
        der = writer.get_extra_info("ssl_object").getpeercert(binary_form=True)
        if hashlib.sha256(der).hexdigest() != console.get("certSha256"):
            writer.close()
            raise ProtectError(f"{console['name']}: stream certificate does not match the pinned one")
        self.console = console
        self.upstream_reader, self.upstream_writer = reader, writer
        self.set_bases(console, name)
        self.pump = asyncio.create_task(self.pump_upstream())

    def set_bases(self, console, name):
        """Set up URL rewriting between the relay and one console."""
        host = f"[{name}]" if ":" in name else name
        self.local_base = f"rtsp://127.0.0.1:{self.relay.port}/{self.relay.token}/{console['id']}"
        self.remote_base = f"rtsps://{host}:{STREAM_PORT}"
        # Absolute URLs in responses (Content-Base, RTP-Info) name the
        # console; they must point back at the relay or the player would
        # bypass it on the next request.
        self.remote_pattern = re.compile(
            r"rtsps?://(?:" + re.escape(host) + r"|[^/\s;,\"]+)(?::\d+)?(?=/)", re.I)

    def to_upstream(self, text):
        return text.replace(self.local_base, self.remote_base)

    def to_client(self, text):
        return self.remote_pattern.sub(self.local_base, text)

    async def run(self):
        try:
            while True:
                message = await read_rtsp_async(self.client_reader)
                if message is None:
                    return
                if message[0] == "frame":
                    # RTCP receiver reports from the player.
                    if self.upstream_writer:
                        self.upstream_writer.write(message[1])
                        await self.upstream_writer.drain()
                    continue
                _, start, headers, body = message
                method, _, rest = start.partition(" ")
                url, _, version = rest.partition(" ")
                cseq = header_value(headers, "cseq")
                console = self.route(url) if url != "*" else self.console
                if console is None:
                    await self.reply(404, "Not Found", cseq)
                    return
                if self.console is not None and console is not self.console:
                    await self.reply(400, "Bad Request", cseq)
                    return
                transport = header_value(headers, "transport")
                if method == "SETUP" and "/TCP" not in transport.upper():
                    # Refuse UDP: FFmpeg then retries over TCP, which keeps
                    # every media packet inside the TLS tunnel.
                    await self.reply(461, "Unsupported Transport", cseq)
                    continue
                if self.upstream_writer is None:
                    try:
                        await self.connect(console)
                    except (OSError, ProtectError, asyncio.TimeoutError):
                        await self.reply(502, "Bad Gateway", cseq)
                        return
                start = f"{method} {self.to_upstream(url)} {version}"
                headers = [(n, self.to_upstream(v)) for n, v in headers]
                self.upstream_writer.write(encode_rtsp(start, headers, body))
                await self.upstream_writer.drain()
        except OSError:
            pass
        finally:
            self.close()

    async def pump_upstream(self):
        try:
            while True:
                message = await read_rtsp_async(self.upstream_reader)
                if message is None:
                    return
                if message[0] == "frame":
                    self.client_writer.write(message[1])
                else:
                    _, start, headers, body = message
                    headers = [(n, self.to_client(v)) for n, v in headers]
                    if body:
                        body = self.to_client(body.decode("latin-1")).encode("latin-1")
                    self.client_writer.write(encode_rtsp(start, headers, body))
                await self.client_writer.drain()
        except OSError:
            pass
        finally:
            self.close()

    def close(self):
        """Idempotent: either direction ending closes the whole session."""
        if self.pump is not None and self.pump is not asyncio.current_task():
            self.pump.cancel()
        for writer in (self.client_writer, self.upstream_writer):
            if writer is not None and not writer.is_closing():
                writer.close()


class Relay:
    def __init__(self, config):
        self.consoles = {c["id"]: c for c in config["consoles"]}
        previous = read_relay_info()
        # Reuse the last port and token, so URLs handed out before an idle
        # exit keep working when a player reconnects.
        self.token = previous.get("token") or secrets.token_urlsafe(18)
        self.server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        self.server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            self.server.bind(("127.0.0.1", int(previous.get("port") or 0)))
        except OSError:
            self.server.bind(("127.0.0.1", 0))
        self.port = self.server.getsockname()[1]
        self.server.listen(32)
        self.active = 0
        self.last_activity = time.monotonic()

    def serve(self):
        """Run the relay's event loop; blocks until the relay exits."""
        asyncio.run(self._serve())

    async def _serve(self):
        write_json(RELAY_INFO, {"pid": os.getpid(), "port": self.port, "token": self.token})
        server = await asyncio.start_server(self.handle, sock=self.server)
        reaper = asyncio.create_task(self.reap_when_idle())
        async with server:
            await server.serve_forever()
        reaper.cancel()

    async def handle(self, reader, writer):
        sock = writer.get_extra_info("socket")
        if sock is not None:
            sock.setsockopt(socket.IPPROTO_TCP, socket.TCP_NODELAY, 1)
        self.active += 1
        try:
            await RelaySession(self, reader, writer).run()
        finally:
            self.active -= 1
            self.last_activity = time.monotonic()

    async def reap_when_idle(self):
        while True:
            await asyncio.sleep(5)
            if self.active == 0 and time.monotonic() - self.last_activity > RELAY_IDLE_EXIT:
                os._exit(0)


def cmd_relay(args):
    """Run the stream relay. Started on demand; exits after a minute idle."""
    # main() restores the default SIGPIPE so the CLI behaves in pipelines;
    # here it would kill the relay the moment any player hangs up. Ignored,
    # a write to a closed socket raises, and only that session ends.
    signal.signal(signal.SIGPIPE, signal.SIG_IGN)
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)
    lock = open(RELAY_LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another relay is already running
    Relay(require_config()).serve()


def is_complete_jpeg(data):
    """True for a whole JPEG: start-of-image first, end-of-image last.

    Some cameras pad the file after the end marker, so trailing zero bytes
    are allowed.
    """
    return bool(data) and data[:2] == b"\xff\xd8" and data.rstrip(b"\x00")[-2:] == b"\xff\xd9"


# ---- alerts --------------------------------------------------------------
#
# Protect publishes events (motion, smart detections, doorbell rings) on a
# WebSocket of the Integration API. The `events` listener holds one such
# connection per console that has an armed camera, over the same pinned TLS
# as every other request, and records matching events in alerts.json for
# the bar and panel. It only listens: detection itself is configured in
# Protect, per camera.

ALERT_TRIGGERS = ("person", "vehicle", "animal", "package", "ring", "motion")
DEFAULT_TRIGGERS = ["person", "vehicle", "ring"]
SMART_EVENT_TYPES = ("smartDetectZone", "smartDetectLine", "smartDetectLoiter")
EVENTS_WS_PATH = API_BASE + "/subscribe/events"
ALERTS_PATH = os.path.join(RUNTIME_DIR, "alerts.json")
ALERTS_ACK_PATH = os.path.join(RUNTIME_DIR, "alerts-ack.json")
EVENTS_LOCK = os.path.join(RUNTIME_DIR, "events.lock")
ALERTS_KEEP = 50
ALERT_IMAGES_DIR = os.path.join(RUNTIME_DIR, "alerts")
# Event IDs come from the console; anything else never names a file.
EVENT_ID = re.compile(r"[A-Za-z0-9_-]{1,64}")
ALERT_IMAGE = re.compile(r"[A-Za-z0-9_-]{1,64}\.jpg")
NOTIFY_EVERY = 60   # seconds; at most one notification per camera per minute
CAPTURE_EVERY = 5   # seconds; at most one alert snapshot per camera
PLUGIN_ID = "com.eldtechnologies.unifi-protect"
ALERTS_MAX_AGE = 24 * 3600
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"


def alert_kind(event, triggers):
    """The armed trigger an event matches, or None."""
    kind = event.get("type")
    if kind == "ring":
        return "ring" if "ring" in triggers else None
    if kind == "motion":
        return "motion" if "motion" in triggers else None
    if kind in SMART_EVENT_TYPES:
        for detected in event.get("smartDetectTypes") or []:
            if detected in triggers:
                return detected
    return None


def event_time(value):
    """Protect timestamps are epoch milliseconds; return epoch seconds."""
    try:
        value = float(value)
    except (TypeError, ValueError):
        return None
    return value / 1000 if value > 1e11 else value


def ws_frame(opcode, payload=b""):
    """One client-to-server frame. Clients must mask what they send."""
    mask = os.urandom(4)
    length = len(payload)
    if length < 126:
        header = bytes([0x80 | opcode, 0x80 | length])
    elif length < 65536:
        header = bytes([0x80 | opcode, 0x80 | 126]) + length.to_bytes(2, "big")
    else:
        header = bytes([0x80 | opcode, 0x80 | 127]) + length.to_bytes(8, "big")
    return header + mask + bytes(b ^ mask[i % 4] for i, b in enumerate(payload))


async def ws_open(console, path, timeout=10):
    """Open a WebSocket to a console over pinned TLS, authenticated by API key."""
    if not console.get("apiKey"):
        raise ProtectError(console.get("keyError", "no API key configured"))
    name, port = split_host(console["host"])
    context = ssl.create_default_context()
    context.check_hostname = False
    context.verify_mode = ssl.CERT_NONE
    reader, writer = await asyncio.wait_for(
        asyncio.open_connection(name, port, ssl=context, server_hostname=name), timeout)
    der = writer.get_extra_info("ssl_object").getpeercert(binary_form=True)
    if hashlib.sha256(der).hexdigest() != console.get("certSha256"):
        writer.close()
        raise ProtectError("console certificate changed; if expected, run `eld-unifi-protect trust-cert`")
    key = base64.b64encode(os.urandom(16)).decode()
    writer.write((f"GET {path} HTTP/1.1\r\nHost: {name}\r\nUpgrade: websocket\r\n"
                  f"Connection: Upgrade\r\nSec-WebSocket-Key: {key}\r\n"
                  f"Sec-WebSocket-Version: 13\r\nX-API-KEY: {console['apiKey']}\r\n\r\n").encode())
    await writer.drain()
    head = (await asyncio.wait_for(reader.readuntil(b"\r\n\r\n"), timeout)).decode("latin-1")
    lines = head.split("\r\n")
    status = lines[0].split(" ")
    if len(status) < 2 or status[1] != "101":
        writer.close()
        if len(status) > 1 and status[1] in ("401", "403"):
            raise ProtectError("console rejected the API key for events")
        raise ProtectError(f"event stream refused: {clean_text(lines[0], '', 120)}")
    expected = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
    accept = next((l.split(":", 1)[1].strip() for l in lines[1:]
                   if l.lower().startswith("sec-websocket-accept:")), "")
    if accept != expected:
        writer.close()
        raise ProtectError("event stream handshake failed")
    return reader, writer


async def ws_messages(reader, writer, idle=60):
    """Yield text messages; answer pings; stop on close.

    If nothing arrives for `idle` seconds, ping once; a second silent
    period means the connection is dead and raises TimeoutError.
    """
    fragments = bytearray()
    pinged = False
    while True:
        try:
            head = await asyncio.wait_for(reader.readexactly(2), idle)
        except asyncio.TimeoutError:
            if pinged:
                raise
            writer.write(ws_frame(0x9, b"keepalive"))
            await writer.drain()
            pinged = True
            continue
        pinged = False
        fin, opcode = head[0] & 0x80, head[0] & 0x0F
        masked, length = head[1] & 0x80, head[1] & 0x7F
        if length == 126:
            length = int.from_bytes(await reader.readexactly(2), "big")
        elif length == 127:
            length = int.from_bytes(await reader.readexactly(8), "big")
        if length > 1 << 20:
            raise ProtectError("event message too large")
        mask = await reader.readexactly(4) if masked else None
        payload = await reader.readexactly(length)
        if mask:
            payload = bytes(b ^ mask[i % 4] for i, b in enumerate(payload))
        if opcode == 0x9:
            writer.write(ws_frame(0xA, payload))
            await writer.drain()
        elif opcode == 0x8:
            return
        elif opcode in (0x0, 0x1):
            fragments += payload
            if fin:
                text, fragments = fragments.decode("utf-8", "replace"), bytearray()
                yield text


def armed_cameras(config, prefs):
    """console id -> {camera id: camera summary} for armed cameras.

    Read from the last camera list, so the listener needs no extra API
    calls; arming a camera polls first, so the list is current.
    """
    armed = {}
    for camera in previous_state().get("cameras", []):
        triggers = prefs["alerts"].get(camera_key(camera))
        if triggers:
            armed.setdefault(camera["console"], {})[camera["id"]] = dict(camera, alerts=triggers)
    known = {c["id"] for c in config["consoles"]}
    return {k: v for k, v in armed.items() if k in known}


def read_ack():
    try:
        with open(ALERTS_ACK_PATH) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def alert_image_path(name):
    """An alert snapshot's path, only ever inside ALERT_IMAGES_DIR; else ""."""
    return os.path.join(ALERT_IMAGES_DIR, name) if ALERT_IMAGE.fullmatch(str(name or "")) else ""


def prune_alert_images(keep):
    """Delete alert snapshots no longer referenced by the log."""
    try:
        entries = list(os.scandir(ALERT_IMAGES_DIR))
    except OSError:
        return
    for entry in entries:
        if entry.name not in keep:
            try:
                os.remove(entry.path)
            except OSError:
                pass


def load_alerts():
    try:
        with open(ALERTS_PATH) as handle:
            alerts = json.load(handle).get("alerts", [])
    except (OSError, ValueError, AttributeError):
        return []
    # Only alerts with a valid event ID, and an image only if its name is safe.
    kept = []
    for alert in alerts if isinstance(alerts, list) else []:
        if isinstance(alert, dict) and EVENT_ID.fullmatch(str(alert.get("id") or "")):
            if alert.get("image") and not alert_image_path(alert["image"]):
                alert = dict(alert, image=None)
            kept.append(alert)
    return kept


# ---- desktop notifications over D-Bus ------------------------------------
#
# notify-send would put the camera, the console and the time in its command
# line, and with --wait it stays running until the notification goes away;
# every local user can read command lines through /proc. So the helper
# speaks the session bus itself: just enough D-Bus to call Notify and hear
# which action was chosen, and nothing private ever reaches an argv.

NOTIFY_NAME = "org.freedesktop.Notifications"
NOTIFY_PATH = "/org/freedesktop/Notifications"
DBUS_MAX_MESSAGE = 1 << 20


def session_bus_path():
    """The session bus socket path, or None when there is no session bus."""
    address = os.environ.get("DBUS_SESSION_BUS_ADDRESS") or ""
    for part in address.split(";"):
        kind, _, rest = part.partition(":")
        if kind != "unix":
            continue
        params = dict(item.split("=", 1) for item in rest.split(",") if "=" in item)
        if params.get("path"):
            return urllib.parse.unquote(params["path"])
        if params.get("abstract"):
            return "\0" + urllib.parse.unquote(params["abstract"])
    fallback = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "", "bus")
    return fallback if os.environ.get("XDG_RUNTIME_DIR") and os.path.exists(fallback) else None


class DBusWriter:
    """Little-endian D-Bus marshalling for the few types Notify needs."""

    def __init__(self):
        self.buf = bytearray()

    def pad(self, n):
        self.buf += b"\0" * (-len(self.buf) % n)

    def byte(self, value):
        self.buf.append(value)

    def uint32(self, value):
        self.pad(4)
        self.buf += struct.pack("<I", value)

    def int32(self, value):
        self.pad(4)
        self.buf += struct.pack("<i", value)

    def string(self, value):
        data = value.encode()
        if b"\0" in data:
            raise ValueError("NUL in D-Bus string")
        self.uint32(len(data))
        self.buf += data + b"\0"

    def signature(self, value):
        data = value.encode()
        self.byte(len(data))
        self.buf += data + b"\0"

    def array(self, align, write_items):
        self.uint32(0)
        at = len(self.buf) - 4
        self.pad(align)
        start = len(self.buf)
        write_items()
        struct.pack_into("<I", self.buf, at, len(self.buf) - start)

    def variant(self, code, value):
        self.signature(code)
        {"s": self.string, "o": self.string, "u": self.uint32,
         "y": self.byte, "g": self.signature}[code](value)


def dbus_message(kind, serial, fields, signature="", body=b""):
    """One message: kind 1 is a method call, 2 a reply, 4 a signal."""
    out = DBusWriter()
    out.buf += b"l" + bytes([kind, 0, 1])
    out.uint32(len(body))
    out.uint32(serial)
    if signature:
        fields = fields + [(8, "g", signature)]

    def write_fields():
        for code, kind_code, value in fields:
            out.pad(8)
            out.byte(code)
            out.variant(kind_code, value)
    out.array(8, write_fields)
    out.pad(8)
    return bytes(out.buf) + body


def dbus_call(serial, destination, path, interface, member, signature="", body=b""):
    return dbus_message(1, serial, [(1, "o", path), (2, "s", interface), (3, "s", member),
                                    (6, "s", destination)], signature, body)


class DBusReader:
    def __init__(self, data, little=True):
        self.data, self.pos, self.end = data, 0, "<" if little else ">"

    def align(self, n):
        self.pos += -self.pos % n

    def take(self, n):
        if self.pos + n > len(self.data):
            raise ValueError("truncated D-Bus message")
        chunk = self.data[self.pos:self.pos + n]
        self.pos += n
        return chunk

    def byte(self):
        return self.take(1)[0]

    def uint32(self):
        self.align(4)
        return struct.unpack(self.end + "I", self.take(4))[0]

    def int32(self):
        self.align(4)
        return struct.unpack(self.end + "i", self.take(4))[0]

    def string(self):
        n = self.uint32()
        value = self.take(n + 1)[:-1]
        return value.decode(errors="replace")

    def signature(self):
        n = self.byte()
        return self.take(n + 1)[:-1].decode(errors="replace")

    def value(self, code):
        if code in "so":
            return self.string()
        if code == "g":
            return self.signature()
        if code == "u":
            return self.uint32()
        if code == "i":
            return self.int32()
        if code == "y":
            return self.byte()
        if code == "b":
            return bool(self.uint32())
        raise ValueError(f"unsupported D-Bus type {code!r}")

    def variant(self):
        code = self.signature()
        return self.value(code) if len(code) == 1 else None


def dbus_parse(data):
    """(kind, header fields, body values, raw body) of a whole message.

    Bodies are read only for the simple signatures the helper expects.
    """
    reader = DBusReader(data, little=data[:1] == b"l")
    reader.pos = 1
    kind = reader.byte()
    reader.take(2)
    body_length = reader.uint32()
    serial = reader.uint32()
    fields_length = reader.uint32()
    fields, end = {"serial": serial}, reader.pos + fields_length
    while reader.pos < end:
        reader.align(8)
        code = reader.byte()
        fields[code] = reader.variant()
    reader.align(8)
    raw = reader.take(body_length)
    body = DBusReader(raw, little=data[:1] == b"l")
    values = []
    signature = fields.get(8) or ""
    if signature and all(c in "suyibog" for c in signature):
        values = [body.value(c) for c in signature]
    return kind, fields, values, raw


async def dbus_read(reader):
    head = await reader.readexactly(16)
    little = head[:1] == b"l"
    body_length, _, fields_length = struct.unpack(("<" if little else ">") + "III", head[4:16])
    total = 16 + fields_length + (-fields_length % 8) + body_length
    if total > DBUS_MAX_MESSAGE:
        raise ProtectError("D-Bus message too large")
    return dbus_parse(head + await reader.readexactly(total - 16))


async def dbus_connect(path, timeout=5):
    """Open and authenticate a session bus connection (EXTERNAL, as this uid)."""
    # A leading NUL is an abstract socket; asyncio takes those as they are.
    reader, writer = await asyncio.wait_for(asyncio.open_unix_connection(path), timeout)
    writer.write(b"\0AUTH EXTERNAL " + str(os.getuid()).encode().hex().encode() + b"\r\n")
    await writer.drain()
    answer = await asyncio.wait_for(reader.readline(), timeout)
    if not answer.startswith(b"OK "):
        writer.close()
        raise ProtectError("the session bus refused the connection")
    writer.write(b"BEGIN\r\n")
    return reader, writer


class DBusConnection:
    def __init__(self, reader, writer):
        self.reader, self.writer, self.serial = reader, writer, 0
        self.signals = []

    async def call(self, destination, path, interface, member, signature="", body=b"", timeout=10):
        self.serial += 1
        serial = self.serial
        self.writer.write(dbus_call(serial, destination, path, interface, member, signature, body))
        await self.writer.drain()
        while True:
            kind, fields, values, _ = await asyncio.wait_for(dbus_read(self.reader), timeout)
            if kind in (2, 3) and fields.get(5) == serial:
                if kind == 3:
                    raise ProtectError(f"D-Bus error: {fields.get(4)}")
                return values
            if kind == 4:
                self.signals.append((fields, values))

    async def signal(self):
        if self.signals:
            return self.signals.pop(0)
        while True:
            kind, fields, values, _ = await dbus_read(self.reader)
            if kind == 4:
                return fields, values

    def close(self):
        self.writer.close()


def notify_body(summary, body, image, actions, timeout_ms=-1):
    """The body of Notify(susssasa{sv}i)."""
    out = DBusWriter()
    out.string("UniFi Protect")
    out.uint32(0)
    out.string("")
    out.string(summary)
    out.string(body)

    def write_actions():
        for item in actions:
            out.string(item)
    out.array(4, write_actions)

    def write_hints():
        hints = [("urgency", "y", 1)]
        if image:
            hints.append(("image-path", "s", "file://" + image))
        for key, code, value in hints:
            out.pad(8)
            out.string(key)
            out.variant(code, value)
    out.array(8, write_hints)
    out.int32(timeout_ms)
    return bytes(out.buf)


async def send_desktop_notification(summary, body, image="", actions=(), wait=3600):
    """Show a notification; return the action chosen, or None when it closes."""
    path = session_bus_path()
    if not path:
        raise ProtectError("no session bus")
    bus = DBusConnection(*await dbus_connect(path))
    try:
        await bus.call("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "Hello")
        match = DBusWriter()
        match.string(f"type='signal',sender='{NOTIFY_NAME}',interface='{NOTIFY_NAME}',path='{NOTIFY_PATH}'")
        await bus.call("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                       "AddMatch", "s", bytes(match.buf))
        values = await bus.call(NOTIFY_NAME, NOTIFY_PATH, NOTIFY_NAME, "Notify", "susssasa{sv}i",
                                notify_body(summary, body, image, list(actions)))
        notification = values[0] if values else None
        if not actions:
            return None

        async def chosen():
            while True:
                fields, values = await bus.signal()
                if not values or values[0] != notification:
                    continue
                if fields.get(3) == "ActionInvoked" and len(values) > 1:
                    return values[1]
                if fields.get(3) == "NotificationClosed":
                    return None
        return await asyncio.wait_for(chosen(), wait)
    finally:
        bus.close()


class AlertListener:
    def __init__(self, follow_parent=False):
        self.parent = os.getppid() if follow_parent else None
        self.alerts = load_alerts()
        self.status = {}
        self.event_cameras = {}      # event id -> camera id, for sparse updates
        self.armed = {}
        self.config = None
        self.prefs_stamp = None
        self.tasks = {}
        self.notify_enabled = True
        self.last_notified = {}      # camera uid -> time of its last notification
        self.last_captured = {}      # camera uid -> time of its last alert snapshot

    def refresh(self):
        """Re-read config and arming when cameras.json or config.json change."""
        stamp = []
        for path in (PREFS_PATH, CONFIG_PATH):
            try:
                stamp.append(os.stat(path).st_mtime_ns)
            except OSError:
                stamp.append(None)
        if stamp == self.prefs_stamp and self.config is not None:
            return
        self.prefs_stamp = stamp
        self.config = load_config() or {"consoles": []}
        prefs = load_prefs()
        self.armed = armed_cameras(self.config, prefs)
        self.notify_enabled = prefs["notify"]

    def save(self):
        # Older than a day, or before the user last cleared the log: drop.
        cutoff = max(time.time() - ALERTS_MAX_AGE, read_ack().get("clearedAt", 0))
        self.alerts = [a for a in self.alerts if (a.get("start") or 0) > cutoff][-ALERTS_KEEP:]
        write_json(ALERTS_PATH, {"updatedAt": time.time(), "alerts": self.alerts,
                                 "consoles": self.status})
        prune_alert_images({a.get("image") for a in self.alerts})

    def handle(self, console_id, message):
        item = message.get("item") or {}
        if item.get("modelKey", "event") != "event" or not item.get("id"):
            return
        event_id = str(item["id"])
        if not EVENT_ID.fullmatch(event_id):
            return  # not a Protect ID; it would name the snapshot file
        camera_id = item.get("device") or self.event_cameras.get(event_id)
        if not camera_id:
            return
        self.event_cameras[event_id] = camera_id
        if len(self.event_cameras) > 1000:
            self.event_cameras.pop(next(iter(self.event_cameras)))
        self.refresh()
        camera = self.armed.get(console_id, {}).get(camera_id)
        existing = next((a for a in self.alerts if a["id"] == event_id), None)
        kind = alert_kind(item, camera["alerts"]) if camera else None
        changed = False
        if kind and existing is None:
            # Smart detections often arrive as an empty "add" followed by an
            # "update" naming what was seen, so either can open an alert.
            existing = {
                "id": event_id, "uid": camera["uid"], "camera": camera["name"],
                "consoleName": camera["consoleName"], "kind": kind,
                "start": event_time(item.get("start")) or time.time(), "end": None,
            }
            self.alerts.append(existing)
            changed = True
            self.on_new_alert(console_id, camera, existing)
        if existing is not None and item.get("end") and not existing.get("end"):
            existing["end"] = event_time(item["end"])
            changed = True
        if changed:
            self.save()

    def on_new_alert(self, console_id, camera, alert):
        """Snapshot the moment for the alert log, then notify."""
        try:
            asyncio.get_running_loop().create_task(self.capture(console_id, camera, alert))
        except RuntimeError:
            pass  # no event loop (called outside the listener)

    async def capture(self, console_id, camera, alert):
        now = time.time()
        console = next((c for c in self.config["consoles"] if c["id"] == console_id), None)
        if console is not None and now - self.last_captured.get(camera["uid"], 0) >= CAPTURE_EVERY:
            self.last_captured[camera["uid"]] = now
            try:
                data = await asyncio.to_thread(
                    lambda: Protect(console, self.config).snapshot(camera["id"]))
                name = f"{alert['id']}.jpg"
                path = alert_image_path(name)
                if not path:
                    raise ProtectError("unsafe alert id")
                os.makedirs(ALERT_IMAGES_DIR, mode=0o700, exist_ok=True)
                write_atomic(path, data)
                alert["image"] = name
                self.save()
            except (ProtectError, OSError):
                pass
        self.notify(console_id, camera, alert)

    def notify(self, console_id, camera, alert):
        """Desktop notification for a new alert, at most once a minute per camera."""
        if not self.notify_enabled or not session_bus_path():
            return
        now = time.time()
        if now - self.last_notified.get(camera["uid"], 0) < NOTIFY_EVERY:
            return
        self.last_notified[camera["uid"]] = now
        console = next((c for c in self.config["consoles"] if c["id"] == console_id), None)
        try:
            asyncio.get_running_loop().create_task(self.send_notification(console, camera, alert))
        except RuntimeError:
            pass  # no event loop (called outside the listener)

    async def send_notification(self, console, camera, alert):
        # The snapshot taken for the alert log is the notification's picture.
        image = alert_image_path(alert.get("image"))
        what = {"person": "Person", "vehicle": "Vehicle", "animal": "Animal",
                "package": "Package", "ring": "Doorbell", "motion": "Motion"}.get(alert["kind"], alert["kind"])
        summary = f"Doorbell at {camera['name']}" if alert["kind"] == "ring" else f"{what} at {camera['name']}"
        body = f"{camera['consoleName']} · {time.strftime('%H:%M', time.localtime(alert['start']))}"
        # Straight to the notification service: nothing private in an argv.
        try:
            chosen = await send_desktop_notification(summary, body, image, ["live", "Watch live"])
        except (OSError, ProtectError, ValueError, asyncio.TimeoutError, asyncio.IncompleteReadError):
            return
        if chosen == "live" and shutil.which("omarchy-shell"):
            # Open the panel on this camera's live view.
            await asyncio.create_subprocess_exec(
                "omarchy-shell", PLUGIN_ID, "live", camera["uid"],
                stdout=asyncio.subprocess.DEVNULL, stderr=asyncio.subprocess.DEVNULL)

    async def watch_console(self, console_id):
        backoff = 2
        while True:
            console = next((c for c in self.config["consoles"] if c["id"] == console_id), None)
            if console is None:
                return
            try:
                reader, writer = await ws_open(console, EVENTS_WS_PATH)
                self.status[console_id] = {"connected": True, "error": None}
                self.save()
                backoff = 2
                try:
                    async for text in ws_messages(reader, writer):
                        try:
                            self.handle(console_id, json.loads(text))
                        except ValueError:
                            continue
                finally:
                    writer.close()
                error = "event stream closed"
            except (OSError, ProtectError, asyncio.TimeoutError, asyncio.IncompleteReadError,
                    asyncio.LimitOverrunError) as exc:
                error = str(exc) or type(exc).__name__
            self.status[console_id] = {"connected": False, "error": error}
            self.save()
            await asyncio.sleep(backoff)
            backoff = min(60, backoff * 2)

    async def run(self):
        while True:
            if self.parent is not None and os.getppid() != self.parent:
                return  # the shell that started us is gone
            if demo_on():
                return  # demo data must never be mixed with real events
            self.refresh()
            if not self.armed:
                self.status = {}
                self.save()
                return  # nothing armed: nothing to listen for
            for console_id in self.armed:
                if console_id not in self.tasks or self.tasks[console_id].done():
                    self.tasks[console_id] = asyncio.create_task(self.watch_console(console_id))
            for console_id in list(self.tasks):
                if console_id not in self.armed:
                    self.tasks.pop(console_id).cancel()
                    self.status.pop(console_id, None)
            await asyncio.sleep(5)


def cmd_events(args):
    """Listen for alerts on armed cameras until none are armed."""
    lock = open(EVENTS_LOCK, "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return  # another listener is already running
    try:
        asyncio.run(AlertListener(follow_parent=args.follow_parent).run())
    except KeyboardInterrupt:
        pass


def cmd_alert(args):
    prefs = load_prefs()
    if args.ack or args.clear:
        ack = read_ack()
        ack["ackedAt"] = time.time()
        if args.clear:
            ack["clearedAt"] = ack["ackedAt"]
        write_json(ALERTS_ACK_PATH, ack)
        if args.clear:
            # The listener drops cleared alerts on its next save. If it isn't
            # running, nothing else writes the log, so empty it here.
            lock = open(EVENTS_LOCK, "w")
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return
            write_json(ALERTS_PATH, {"updatedAt": time.time(), "alerts": [], "consoles": {}})
            prune_alert_images(set())
        return
    if args.notify:
        prefs["notify"] = args.notify == "on"
        save_prefs(prefs)
        poll_cameras()   # the panel reads the setting from the state file
        print("alert notifications " + ("on" if prefs["notify"] else "off"))
        return
    if not args.camera:
        state = poll_cameras(require_config())
        armed = [c for c in state["cameras"] if c.get("alerts")]
        if not armed:
            print("no cameras armed; arm one with: eld-unifi-protect alert <camera>")
        for camera in armed:
            print(f"{camera['name']}  ·  {camera['consoleName']}: {', '.join(camera['alerts'])}")
        for alert in load_alerts()[-10:]:
            when = time.strftime("%H:%M:%S", time.localtime(alert["start"]))
            print(f"  {when}  {alert['kind']:8} {alert['camera']}")
        return
    state = poll_cameras(require_config())
    matches = find_cameras(state["cameras"], args.camera)
    if len(matches) != 1:
        raise ProtectError(f"{args.camera!r} matches {len(matches)} cameras; use its id "
                           "from `eld-unifi-protect cameras`")
    camera = matches[0]
    if args.off:
        prefs["alerts"].pop(camera_key(camera), None)
        print(f"alerts off: {camera['name']}")
    else:
        triggers = [t.strip() for t in (args.on or ",".join(DEFAULT_TRIGGERS)).split(",") if t.strip()]
        unknown = [t for t in triggers if t not in ALERT_TRIGGERS]
        if unknown:
            raise ProtectError(f"unknown trigger {unknown[0]!r}; choose from {', '.join(ALERT_TRIGGERS)}")
        prefs["alerts"][camera_key(camera)] = triggers
        print(f"alerts on: {camera['name']} ({', '.join(triggers)})")
    save_prefs(prefs)
    poll_cameras()


# ---- demo mode -----------------------------------------------------------
#
# Made-up consoles and cameras for screenshots, development and trying the
# plugin without UniFi hardware. While the flag file exists, load_config()
# returns the demo consoles and Protect() returns DemoProtect, so the panel,
# wall, pop-out and alerts all run their normal code on demo data. Nothing
# real is changed: saving the config is refused while the demo is on, and
# the flag lives in the runtime directory, so a reboot always ends it.

DEMO_FLAG = os.path.join(RUNTIME_DIR, "demo.json")
DEMO_DIR = os.path.join(RUNTIME_DIR, "demo")
DEMO_SOURCE = os.path.join(PLUGIN_DIR, "docs", "demo")
DEMO_CONSOLES = [
    {"id": "gateway", "name": "Gateway", "host": "192.0.2.1"},
    {"id": "nvr", "name": "NVR", "host": "192.0.2.2"},
]
# (console, image slug, name, model); ids and MACs are derived from the slug.
DEMO_CAMERAS = [
    ("gateway", "driveway", "Driveway", "G5 Bullet"),
    ("gateway", "garage", "Garage", "G4 Instant"),
    ("nvr", "front-door", "Front Door", "G4 Doorbell Pro"),
    ("nvr", "garden", "Garden", "G5 Flex"),
    ("nvr", "gate", "Gate", "G6 Bullet"),
    ("nvr", "side-path", "Side Path", "G6 Instant"),
]
DEMO_ARMED = ("Front Door", "Driveway")
# (minutes ago, camera, kind, seconds long or None for ongoing)
DEMO_ALERTS = [(240, "Gate", "vehicle", 22), (95, "Garden", "animal", 41),
               (38, "Front Door", "ring", 9), (14, "Driveway", "vehicle", 17),
               (2, "Front Door", "person", None)]


def demo_on():
    return os.path.exists(DEMO_FLAG)


def demo_camera_id(slug):
    return hashlib.sha1(slug.encode()).hexdigest()[:24]


def demo_config():
    consoles = [dict(c, apiKey="demo", certSha256="", demo=True) for c in DEMO_CONSOLES]
    return {"consoles": consoles, "timeoutSec": 8}


class DemoProtect:
    """Stands in for Protect while the demo is on: local files, no network."""

    def __init__(self, console):
        self.console = console
        self.host = console["host"]

    def info(self):
        return {"applicationVersion": "demo"}

    def cameras(self):
        return [{"id": demo_camera_id(slug), "name": name, "type": f"UVC {model}",
                 "mac": hashlib.md5(slug.encode()).hexdigest()[:12], "state": "CONNECTED"}
                for console, slug, name, model in DEMO_CAMERAS if console == self.console["id"]]

    def snapshot(self, camera_id, high_quality=False):
        with open(os.path.join(DEMO_DIR, f"{camera_id}.jpg"), "rb") as handle:
            return handle.read()

    def stream_urls(self, camera_id, qualities):
        url = "file://" + os.path.join(DEMO_DIR, f"{camera_id}.mp4")
        return {q: url for q in qualities}

    def stream_url(self, camera_id, quality):
        return self.stream_urls(camera_id, [quality])[quality]


def demo_source_image(slug):
    for ext in ("jpg", "jpeg", "png", "webp"):
        path = os.path.join(DEMO_SOURCE, f"{slug}.{ext}")
        if os.path.isfile(path):
            return path
    return None


def build_demo_camera(slug, name):
    """Snapshot with a camera-style timestamp, and a looping 'live' clip."""
    magick, ffmpeg = shutil.which("magick"), shutil.which("ffmpeg")
    if not magick or not ffmpeg:
        raise ProtectError("demo mode needs ImageMagick (magick) and ffmpeg")
    camera_id = demo_camera_id(slug)
    snapshot = os.path.join(DEMO_DIR, f"{camera_id}.jpg")
    source = demo_source_image(slug)
    if source:
        # Demo images already carry a camera-style timestamp. Blur the top
        # left corner, where generated images tend to put a vendor logo:
        # the screenshots must not suggest an official product.
        render = [source, "-resize", "1920x1080^", "-gravity", "center", "-extent", "1920x1080",
                  "-gravity", "NorthWest", "-region", "300x130+0+0", "-blur", "0x22", "+region"]
    else:
        stamp = time.strftime("%Y-%m-%d %H:%M:%S") + "  " + name
        render = ["-size", "1920x1080", "gradient:#33434c-#11181c", "-gravity", "center",
                  "-fill", "#ffffff30", "-pointsize", "96", "-annotate", "0", name,
                  # Inset enough to survive the clip's slow zoom.
                  "-gravity", "NorthWest", "-pointsize", "30",
                  "-fill", "#00000090", "-annotate", "+92+62", stamp,
                  "-fill", "white", "-annotate", "+90+60", stamp]
    subprocess.run([magick, *render, "-quality", "88", snapshot], check=True, capture_output=True)
    # A slow drift, so the 'live' view visibly moves; 60 s, looped by players.
    subprocess.run([ffmpeg, "-y", "-loglevel", "error", "-loop", "1", "-framerate", "15",
                    "-i", snapshot, "-t", "60", "-vf",
                    "scale=1920:1080,zoompan=z='1.04+0.03*sin(on/90)':"
                    "x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':d=1:s=1280x720:fps=15,"
                    # JPEG input is full-range; players expect standard
                    # (limited-range) yuv420p, or show nothing at all.
                    "scale=out_range=tv,format=yuv420p",
                    "-c:v", "libx264", "-preset", "veryfast", "-pix_fmt", "yuv420p",
                    os.path.join(DEMO_DIR, f"{camera_id}.mp4")],
                   check=True, capture_output=True)
    return camera_id


def cmd_demo(args):
    if args.mode == "status":
        print("demo mode " + ("on" if demo_on() else "off"))
        return
    if args.mode == "off":
        for path in (DEMO_FLAG, ALERTS_PATH, ALERTS_ACK_PATH, SNAP_INDEX):
            try:
                os.remove(path)
            except FileNotFoundError:
                pass
        for folder in (DEMO_DIR, ALERT_IMAGES_DIR, SNAP_DIR, RECORDINGS_DIR, CLIPS_DIR):
            shutil.rmtree(folder, ignore_errors=True)
        poll_cameras()
        print("demo mode off; your consoles are back")
        return
    os.makedirs(DEMO_DIR, mode=0o700, exist_ok=True)
    print("rendering demo cameras…")
    with ThreadPoolExecutor(max_workers=3) as pool:
        ids = dict(zip([n for _, _, n, _ in DEMO_CAMERAS],
                       pool.map(lambda c: build_demo_camera(c[1], c[2]), DEMO_CAMERAS)))
    missing = [slug for _, slug, _, _ in DEMO_CAMERAS if not demo_source_image(slug)]
    write_json(DEMO_FLAG, {"since": time.time()})
    # A believable alert log, with snapshots, ending in an unseen alert.
    now = time.time()
    alerts = []
    os.makedirs(ALERT_IMAGES_DIR, mode=0o700, exist_ok=True)
    for i, (minutes, name, kind, length) in enumerate(DEMO_ALERTS):
        console = next(c for c, _, n, _ in DEMO_CAMERAS if n == name)
        image = f"demo-{i}.jpg"
        shutil.copyfile(os.path.join(DEMO_DIR, f"{ids[name]}.jpg"), os.path.join(ALERT_IMAGES_DIR, image))
        start = now - minutes * 60
        alerts.append({"id": f"demo-{i}", "uid": f"{console}_{ids[name]}", "camera": name,
                       "consoleName": "Gateway" if console == "gateway" else "NVR", "kind": kind,
                       "start": start, "end": start + length if length else None, "image": image})
    write_json(ALERTS_PATH, {"updatedAt": now, "alerts": alerts, "consoles": {}})
    write_json(ALERTS_ACK_PATH, {"ackedAt": now - 20 * 60})
    poll_cameras()
    print("demo mode on: 2 consoles, 6 cameras, an alert log. `eld-unifi-protect demo off` ends it.")
    if missing:
        print(f"no image yet for: {', '.join(missing)} (placeholders used; add them to {DEMO_SOURCE})")


class Protect:
    def __new__(cls, console, config=None):
        if console.get("demo"):
            return DemoProtect(console)
        return super().__new__(cls)

    def __init__(self, console, config=None):
        self.console = console
        self.host = console["host"]
        self.name, self.port = split_host(self.host)
        if not console.get("apiKey"):
            # Callers already prefix errors with the console's name.
            raise ProtectError(console.get("keyError", "no API key configured"))
        self.key = console["apiKey"]
        self.pin = console.get("certSha256")
        self.timeout = float((config or {}).get("timeoutSec", 8))

    def request(self, method, path, body=None, params=None, raw=False):
        # The Integration API rate-limits per key. A burst (opening the wall,
        # several cameras at once) gets 429s that clear within a second or
        # two, so wait as asked and try again rather than fail the camera.
        for attempt in range(4):
            status, headers, data = self._send(method, path, body, params)
            if status != 429 or attempt == 3:
                break
            try:
                delay = float(headers.get("Retry-After") or 0)
            except ValueError:
                delay = 0
            time.sleep(min(10.0, delay or 0.5 * 2 ** attempt))
        if status in (401, 403):
            raise ProtectError("console rejected the API key (HTTP %d)" % status)
        if status == 404:
            raise ProtectError("not found: is UniFi Protect installed and up to date on this console?")
        if status == 429:
            raise ProtectError("console is rate limiting requests; try again in a moment")
        if status >= 400:
            detail = clean_text(data[:200].decode(errors="replace"), "", 200)
            raise ProtectError(f"HTTP {status} from console: {detail}")
        if raw:
            return data
        return json.loads(data) if data else None

    def _send(self, method, path, body, params):
        url = API_BASE + path
        if params:
            url += "?" + urllib.parse.urlencode(params, doseq=True)
        headers = {"X-API-KEY": self.key, "Accept": "application/json"}
        payload = None
        if body is not None:
            payload = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        conn = PinnedHTTPSConnection(self.name, self.port, self.pin, self.timeout)
        try:
            conn.request(method, url, body=payload, headers=headers)
            response = conn.getresponse()
            return response.status, response.headers, response.read()
        except ProtectError:
            raise
        except (OSError, http.client.HTTPException) as error:
            raise ProtectError(f"cannot reach {self.host}: {error}")
        finally:
            conn.close()

    def info(self):
        return self.request("GET", "/meta/info")

    def cameras(self):
        return self.request("GET", "/cameras") or []

    def snapshot(self, camera_id, high_quality=False):
        data = self.request(
            "GET",
            f"/cameras/{camera_id}/snapshot",
            params={"highQuality": "true" if high_quality else "false"},
            raw=True,
        )
        if not is_complete_jpeg(data):
            # A cut-off transfer or an error page: keep the previous frame
            # on screen rather than a half-drawn one.
            raise ProtectError("console sent an incomplete snapshot")
        return data

    def stream_urls(self, camera_id, qualities):
        """Relay URLs for the given qualities, creating any that are missing.

        Creating a stream turns on RTSPS for that channel on the camera; it
        stays enabled, so this happens once per quality. Protect's URLs are
        stable, so they are cached for the session rather than fetched per
        view; the relay URL wrapping them is built fresh each time.
        """
        cache = load_stream_cache()
        cache_key = f"{self.host}/{camera_id}"
        known = cache.get(cache_key, {})
        if all(known.get(q) for q in qualities):
            return {q: relay_url(self.console["id"], known[q]) for q in qualities}

        streams = self.request("GET", f"/cameras/{camera_id}/rtsps-stream") or {}
        missing = [q for q in qualities if not streams.get(q)]
        if missing and load_prefs()["readOnly"]:
            # Read-only: never switch streams on. Fall back to whichever
            # quality is already enabled, nearest to the one asked for.
            enabled = [q for q in QUALITIES if streams.get(q)]
            if not enabled:
                raise ProtectError(
                    "no stream is enabled for this camera. Turn on RTSPS in Protect "
                    "(camera → Settings → Advanced), or let the plugin do it: "
                    "eld-unifi-protect read-only off")
            for quality in missing:
                order = QUALITIES[QUALITIES.index(quality):] + QUALITIES[:QUALITIES.index(quality)][::-1]
                streams[quality] = streams[next(q for q in order if q in enabled)]
            missing = []
        if missing:
            created = self.request(
                "POST", f"/cameras/{camera_id}/rtsps-stream", body={"qualities": missing}
            ) or {}
            streams.update({k: v for k, v in created.items() if v})
        urls = {}
        for quality in qualities:
            url = streams.get(quality)
            if not url:
                raise ProtectError(f"console did not return a {quality} stream for this camera")
            urls[quality] = url
        with STREAM_CACHE_LOCK:
            # Re-read under the lock so concurrent lookups add to the cache
            # instead of overwriting each other's entries.
            cache = load_stream_cache()
            cache.setdefault(cache_key, {}).update(urls)
            write_json(STREAM_CACHE, cache)
        return {q: relay_url(self.console["id"], u) for q, u in urls.items()}

    def stream_url(self, camera_id, quality):
        return self.stream_urls(camera_id, [quality])[quality]


# Text and IDs from a console are untrusted input. Names are printed to
# terminals and shown in the panel; IDs become file names and URL paths.
CAMERA_ID = re.compile(r"[A-Za-z0-9_-]{1,64}")


def clean_text(value, fallback="", limit=80):
    """Printable text only: drops control and format characters (including
    terminal escape sequences), collapses whitespace, caps the length."""
    text = "".join(ch if unicodedata.category(ch)[0] not in "CZ" else " "
                   for ch in str(value or ""))
    text = " ".join(text.split())[:limit]
    return text or fallback


def summarize_camera(camera, console):
    camera_id = str(camera.get("id") or "")
    if not CAMERA_ID.fullmatch(camera_id):
        return None  # not a Protect ID; never let it near a path or URL
    flags = camera.get("featureFlags") or {}
    state = clean_text(camera.get("state"), "UNKNOWN", 32)
    model = clean_text(camera.get("type") or camera.get("modelKey"))
    return {
        "uid": console["id"] + "_" + camera_id,
        "id": camera_id,
        "console": console["id"],
        "consoleName": console["name"],
        "mac": re.sub(r"[^0-9a-f]", "", str(camera.get("mac") or "").lower()),
        "name": clean_text(camera.get("name"), model or "Camera"),
        "model": model,
        "state": state,
        "online": state == "CONNECTED",
        "hasMic": bool(flags.get("hasMic")),
        "hasPackageCamera": bool(camera.get("hasPackageCamera")),
    }


# ---- recordings ------------------------------------------------------------
#
# The Integration API has no recordings: API keys can list cameras and play
# them live, nothing more. Recorded video comes from the endpoints Protect's
# own web app uses (/proxy/protect/api), which need a signed-in user instead
# of a key. The plugin signs in with a local UniFi account the user creates
# for it (ideally view-only), over the same pinned TLS as everything else.
# The password lives in the keyring like the API key, under its own service
# name, so a lookup for one can never return the other. These endpoints are
# not a published API and may change with a Protect update; everything else
# in the plugin keeps working if they do.

LOGIN_SERVICE = KEYRING_SERVICE + "-login"
PRIVATE_API = "/proxy/protect/api"
SESSIONS_PATH = os.path.join(RUNTIME_DIR, "sessions.json")
SESSIONS_LOCK = threading.Lock()
RECORDINGS_DIR = os.path.join(RUNTIME_DIR, "recordings")
CLIPS_DIR = os.path.join(RUNTIME_DIR, "clips")
CLIP_PAD = 3                # seconds of context either side of an event
CLIP_MAX_SECONDS = 300      # longer events are cut to their first five minutes
CLIP_ONGOING_SECONDS = 60   # an event still in progress: its first minute so far
CLIPS_MAX_BYTES = 600 * 1024 * 1024   # clips live in RAM (the runtime dir)
CLIPS_KEEP = 25
CLIP_CHANNELS = {"high": 0, "medium": 1, "low": 2}
RECORDING_KINDS = ("person", "vehicle", "animal", "package", "face", "licensePlate")


def login_password(console):
    """The console's login password, or "" when none is stored."""
    if console.get("loginStore") == "keyring":
        cache_key = (LOGIN_SERVICE, console["id"])
        if cache_key not in _key_cache:
            try:
                result = _secret_tool(["lookup", "service", LOGIN_SERVICE, "console", console["id"]])
            except KeyringUnavailable as error:
                raise ProtectError(f"cannot read the login password from the keyring: {error}")
            _key_cache[cache_key] = result.stdout if result.returncode == 0 else ""
        return _key_cache[cache_key]
    return console.get("loginPassword", "")


def has_login(console):
    return bool(console.get("demo") or console.get("loginUser"))


def store_login(console, user, password):
    """Keyring if possible, else the config file (mode 0600)."""
    console["loginUser"] = user
    try:
        result = _secret_tool(["store", f"--label=UniFi Protect login ({console['name']}, {console['host']})",
                               "service", LOGIN_SERVICE, "console", console["id"]], secret=password)
        if result.returncode != 0:
            raise KeyringUnavailable("the keyring refused to store the password")
        _key_cache[(LOGIN_SERVICE, console["id"])] = password
        console["loginStore"] = "keyring"
        console.pop("loginPassword", None)
        return "keyring"
    except KeyringUnavailable:
        # A password stored earlier must not outlive the one that replaced it.
        _key_cache.pop((LOGIN_SERVICE, console["id"]), None)
        try:
            _secret_tool(["clear", "service", LOGIN_SERVICE, "console", console["id"]])
        except KeyringUnavailable:
            pass
        console.pop("loginStore", None)
        console["loginPassword"] = password
        return "file"


def clear_login(console):
    if console.get("loginStore") == "keyring":
        _key_cache.pop((LOGIN_SERVICE, console["id"]), None)
        try:
            _secret_tool(["clear", "service", LOGIN_SERVICE, "console", console["id"]])
        except KeyringUnavailable as error:
            print(f"Could not remove the password from the keyring: {error}", file=sys.stderr)
    for field in ("loginUser", "loginStore", "loginPassword"):
        console.pop(field, None)
    forget_session(console["id"])


def load_sessions():
    try:
        with open(SESSIONS_PATH) as handle:
            sessions = json.load(handle)
        return sessions if isinstance(sessions, dict) else {}
    except (OSError, ValueError):
        return {}


def forget_session(console_id):
    with SESSIONS_LOCK:
        sessions = load_sessions()
        if sessions.pop(console_id, None) is not None:
            write_json(SESSIONS_PATH, sessions)


def token_expiry(token):
    """When a UniFi OS session token (a JWT) runs out, by this machine's clock.

    The token's lifetime (exp - iat) counts from now, so a desktop clock that
    is off from the console's neither expires sessions early nor keeps dead
    ones. Without iat, exp itself; without either, an hour from now.
    """
    try:
        payload = token.split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
        if "iat" in claims:
            return time.time() + float(claims["exp"]) - float(claims["iat"])
        return float(claims["exp"])
    except (IndexError, KeyError, TypeError, ValueError):
        return time.time() + 3600


def event_kind(event):
    """What a Protect event saw, as one word for the timeline."""
    kind = event.get("type")
    if kind in SMART_EVENT_TYPES:
        seen = [t for t in event.get("smartDetectTypes") or [] if t in RECORDING_KINDS]
        return seen[0] if seen else "motion"
    if kind == "ring":
        return "ring"
    if kind == "smartAudioDetect":
        return "audio"
    return "motion"


def clip_window(start, end, now=None):
    """The (start, end) seconds to export for an event: padded and capped.

    Event times come from the console's clock, so this machine's clock only
    bounds an event still in progress, and never ends a clip before it starts.
    """
    now = now or time.time()
    if not end:
        return start - CLIP_PAD, max(start + CLIP_PAD, min(now, start + CLIP_ONGOING_SECONDS))
    return start - CLIP_PAD, min(end, start + CLIP_MAX_SECONDS) + CLIP_PAD


def clip_path(uid, start, end, quality):
    key = hashlib.sha256(f"{uid}|{start:.3f}|{end:.3f}|{quality}".encode()).hexdigest()[:24]
    return os.path.join(CLIPS_DIR, f"{key}.mp4")


def prune_clips(keep_path=None):
    """Oldest-used clips go first once there are too many or they take too much RAM."""
    try:
        names = os.listdir(CLIPS_DIR)
    except FileNotFoundError:
        return
    # Downloads cut short leave a .part behind; one untouched for ten minutes
    # is not coming back.
    for name in names:
        path = os.path.join(CLIPS_DIR, name)
        try:
            if name.endswith(".part") and os.stat(path).st_mtime < time.time() - 600:
                os.remove(path)
        except FileNotFoundError:
            pass
    entries = [os.path.join(CLIPS_DIR, n) for n in names if n.endswith(".mp4")]
    entries.sort(key=lambda p: os.stat(p).st_mtime, reverse=True)
    total = 0
    for index, path in enumerate(entries):
        total += os.path.getsize(path)
        if path != keep_path and (index >= CLIPS_KEEP or total > CLIPS_MAX_BYTES):
            try:
                os.remove(path)
            except FileNotFoundError:
                pass


class ProtectSession:
    """Signed-in access to the recordings endpoints of one console."""

    def __new__(cls, console, config=None):
        if console.get("demo"):
            return DemoSession(console)
        return super().__new__(cls)

    def __init__(self, console, config=None):
        if not has_login(console):
            raise ProtectError("no login for recordings on this console; "
                               f"run `eld-unifi-protect login {console['id']}`")
        self.console = console
        self.host = console["host"]
        self.name, self.port = split_host(self.host)
        self.pin = console.get("certSha256")
        self.timeout = float((config or {}).get("timeoutSec", 8))
        self.session = load_sessions().get(console["id"])
        # Thumbnails are fetched four at a time through one session.
        self.lock = threading.Lock()

    def _send(self, method, path, body=None, params=None, headers=None, timeout=None):
        url = path + ("?" + urllib.parse.urlencode(params, doseq=True) if params else "")
        headers = dict(headers or {})
        payload = None
        if body is not None:
            payload = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        conn = PinnedHTTPSConnection(self.name, self.port, self.pin, timeout or self.timeout)
        try:
            conn.request(method, url, body=payload, headers=headers)
            return conn, conn.getresponse()
        except ProtectError:
            conn.close()
            raise
        except (OSError, http.client.HTTPException) as error:
            conn.close()
            raise ProtectError(f"cannot reach {self.host}: {error}")

    def login(self):
        password = login_password(self.console)
        if not password:
            raise ProtectError("the login password is missing; run `eld-unifi-protect login` again")
        conn, response = self._send("POST", "/api/auth/login", body={
            "username": self.console["loginUser"], "password": password,
            "rememberMe": False, "token": ""})
        try:
            data = response.read(4096)
            cookies = response.headers.get_all("Set-Cookie") or []
        finally:
            conn.close()
        if response.status == 429:
            raise ProtectError("the console is limiting sign-ins after failed attempts; wait a few minutes")
        if response.status in (401, 403):
            if b"MFA" in data or b"2fa" in data.lower():
                raise ProtectError("this account signs in with two-factor authentication; "
                                   "use a local account (Restrict to local access only)")
            raise ProtectError("the console rejected the username or password")
        if response.status != 200:
            raise ProtectError(f"sign-in failed: HTTP {response.status}")
        token = next((c.split(";", 1)[0].split("=", 1)[1] for c in cookies
                      if c.startswith("TOKEN=")), "")
        if not token:
            raise ProtectError("the console signed in but sent no session cookie")
        self.session = {"token": token, "expires": token_expiry(token),
                        "csrf": response.headers.get("X-Updated-CSRF-Token")
                                or response.headers.get("X-CSRF-Token") or ""}
        with SESSIONS_LOCK:
            sessions = load_sessions()
            sessions[self.console["id"]] = self.session
            write_json(SESSIONS_PATH, sessions)

    def open(self, path, params=None, timeout=None):
        """GET a recordings endpoint; returns (conn, response) with status 200.

        Signs in when there is no session or it has run out, and once more if
        the console turns the saved one down. Never retries a failed sign-in:
        UniFi OS locks accounts out after a burst of those.
        """
        for attempt in range(2):
            with self.lock:
                if not self.session or self.session.get("expires", 0) < time.time() + 60:
                    self.login()
                session = self.session
            headers = {"Cookie": f"TOKEN={session['token']}", "Accept": "*/*"}
            if session.get("csrf"):
                headers["X-CSRF-Token"] = session["csrf"]
            conn, response = self._send("GET", PRIVATE_API + path, params=params,
                                        headers=headers, timeout=timeout)
            if response.status == 401 and attempt == 0:
                conn.close()
                with self.lock:
                    # Another thread may have signed in again already.
                    if self.session is session:
                        self.session = None
                continue
            if response.status == 200:
                return conn, response
            detail = clean_text(response.read(200).decode(errors="replace"), "", 200)
            conn.close()
            if response.status in (401, 403):
                raise ProtectError("this account may not view recordings; give it a Protect role "
                                   "that can (View Only or higher)")
            if response.status == 404:
                raise ProtectError("not found: the recordings endpoint may have changed in this "
                                   "Protect version")
            raise ProtectError(f"HTTP {response.status} from console: {detail}")
        raise ProtectError("the console keeps refusing the session")

    def get(self, path, params=None, limit=8 * 1024 * 1024):
        conn, response = self.open(path, params)
        try:
            return response.read(limit)
        finally:
            conn.close()

    def events(self, camera_id, since, until, motion=False, limit=100):
        """Events newest first; camera_id None lists every camera's."""
        types = ["smartDetectZone", "smartDetectLine", "smartDetectLoiter", "ring"]
        if motion:
            types.append("motion")
        params = {"start": int(since * 1000), "end": int(until * 1000), "limit": limit,
                  "orderDirection": "DESC", "withoutDescriptions": "true", "types": types}
        if camera_id:
            params["cameras"] = camera_id
        raw = json.loads(self.get("/events", params=params))
        events = []
        for event in raw if isinstance(raw, list) else []:
            event_id = str(event.get("id") or "")
            start = event_time(event.get("start"))
            # The filter is applied here too: the console's own may change.
            if (not EVENT_ID.fullmatch(event_id) or start is None
                    or (camera_id and event.get("camera") not in (None, camera_id))
                    or event.get("type") not in types):
                continue
            events.append({"id": event_id, "kind": event_kind(event), "start": start,
                           "end": event_time(event.get("end")),
                           "score": event.get("score") if isinstance(event.get("score"), int) else None})
        return sorted(events, key=lambda e: e["start"], reverse=True)

    def thumbnail(self, event_id):
        data = self.get(f"/events/{event_id}/thumbnail", params={"w": 320})
        if not is_complete_jpeg(data):
            raise ProtectError("console sent no thumbnail")
        return data

    def export(self, camera_id, start, end, quality, path):
        """Write the recording between two times (seconds) to path as MP4."""
        conn, response = self.open("/video/export", params={
            "camera": camera_id, "start": int(start * 1000), "end": int(end * 1000),
            "channel": CLIP_CHANNELS[quality]}, timeout=120)
        partial = f"{path}.{os.getpid()}.part"
        written = 0
        try:
            with open(os.open(partial, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as out:
                while True:
                    chunk = response.read(256 * 1024)
                    if not chunk:
                        break
                    written += len(chunk)
                    if written > CLIPS_MAX_BYTES:
                        raise ProtectError("the clip is too large to keep in memory; try a lower quality")
                    out.write(chunk)
            with open(partial, "rb") as handle:
                head = handle.read(12)
            # An MP4 starts with an "ftyp" box; anything else is an error page.
            if written < 1024 or head[4:8] != b"ftyp":
                raise ProtectError("the console sent no video for that time; "
                                   "is the camera recording it?")
            os.replace(partial, path)
        except OSError as error:
            raise ProtectError(f"cannot save the clip: {error}")
        finally:
            conn.close()
            if os.path.exists(partial):
                os.remove(partial)


class DemoSession:
    """Recordings for demo mode: made-up events, clips cut from the demo video."""

    def __init__(self, console):
        self.console = console

    def events(self, camera_id, since, until, motion=False, limit=100):
        slug = next((s for _, s, _, _ in DEMO_CAMERAS if demo_camera_id(s) == camera_id), "")
        rng = random.Random(slug)
        kinds = ["person", "vehicle", "person", "animal", "ring" if slug == "front-door" else "person"]
        events, at = [], until - rng.uniform(120, 900)
        while at > since and len(events) < 14:
            length = rng.uniform(6, 48)
            events.append({"id": f"demo{len(events)}{(camera_id or '')[:8]}", "kind": rng.choice(kinds),
                           "start": at, "end": at + length, "score": rng.randint(70, 98)})
            at -= rng.uniform(900, 7200)
        if motion:
            events.append({"id": f"demom{(camera_id or '')[:8]}", "kind": "motion", "start": until - 1800,
                           "end": until - 1790, "score": None})
            events.sort(key=lambda e: e["start"], reverse=True)
        return events

    def thumbnail(self, event_id):
        camera = next(demo_camera_id(s) for _, s, _, _ in DEMO_CAMERAS if demo_camera_id(s)[:8] in event_id)
        with open(os.path.join(DEMO_DIR, f"{camera}.jpg"), "rb") as handle:
            return handle.read()

    def export(self, camera_id, start, end, quality, path):
        ffmpeg = shutil.which("ffmpeg")
        if not ffmpeg:
            raise ProtectError("demo mode needs ffmpeg")
        partial = f"{path}.{os.getpid()}.part"
        try:
            subprocess.run([ffmpeg, "-y", "-loglevel", "error", "-i", os.path.join(DEMO_DIR, f"{camera_id}.mp4"),
                            "-t", f"{min(end - start, 59):.1f}", "-c", "copy", "-f", "mp4", partial],
                           check=True, capture_output=True)
            os.chmod(partial, 0o600)
            os.replace(partial, path)
        except subprocess.CalledProcessError as error:
            raise ProtectError(f"demo clip failed: {error.stderr.decode(errors='replace').strip()}")
        finally:
            if os.path.exists(partial):
                os.remove(partial)


def recordings_for(config, uid, hours=24, motion=False):
    """The camera's recent events, with thumbnails on disk, for the panel."""
    client_console = None
    console_id, _, camera_id = uid.partition("_")
    for console in config["consoles"]:
        if console["id"] == console_id:
            client_console = console
    if client_console is None or not CAMERA_ID.fullmatch(camera_id):
        raise ProtectError(f"no camera {uid!r}")
    result = {"uid": uid, "console": console_id, "consoleName": client_console["name"]}
    if not has_login(client_console):
        return dict(result, needsLogin=True, events=[])
    session = ProtectSession(client_console, config)
    now = time.time()
    events = session.events(camera_id, now - hours * 3600, now, motion=motion)
    folder = os.path.join(RECORDINGS_DIR, uid)
    os.makedirs(folder, mode=0o700, exist_ok=True)

    def thumb(event):
        path = os.path.join(folder, event["id"] + ".jpg")
        if not os.path.exists(path):
            try:
                write_atomic(path, session.thumbnail(event["id"]))
            except ProtectError:
                return dict(event, thumb="")
        return dict(event, thumb=path)

    with ThreadPoolExecutor(max_workers=4) as pool:
        events = list(pool.map(thumb, events))
    # Thumbnails of events that dropped out of the window go too.
    wanted = {e["id"] + ".jpg" for e in events}
    for name in os.listdir(folder):
        if name not in wanted:
            os.remove(os.path.join(folder, name))
    return dict(result, events=events)


def fetch_clip(config, uid, start, end, quality):
    """Export (or reuse) the clip for an event; returns its path and real span."""
    console_id, _, camera_id = uid.partition("_")
    console = next((c for c in config["consoles"] if c["id"] == console_id), None)
    if console is None or not CAMERA_ID.fullmatch(camera_id):
        raise ProtectError(f"no camera {uid!r}")
    clip_start, clip_end = clip_window(start, end)
    path = clip_path(uid, clip_start, clip_end, quality)
    if os.path.exists(path):
        os.utime(path)   # most recently used: last to be pruned
    else:
        os.makedirs(CLIPS_DIR, mode=0o700, exist_ok=True)
        ProtectSession(console, config).export(camera_id, clip_start, clip_end, quality, path)
    prune_clips(keep_path=path)
    return {"path": path, "start": clip_start, "end": clip_end}


def mpv_clip_command(player, sound=True):
    """mpv for a recorded clip: seekable, stays open at the end.

    The clip and its title come on stdin (see exec_mpv).
    """
    return [
        player,
        "--no-terminal",
        f"--input-conf={os.path.join(PLUGIN_DIR, 'mpv', 'input.conf')}",
        "--title=${media-title}",
        "--force-window=immediate",
        "--hwdec=auto-safe",
        f"--mute={'no' if sound else 'yes'}",
        "--keep-open=yes",
        "--x11-name=eld-unifi-protect",
        "--wayland-app-id=eld-unifi-protect",
        "--playlist=-",
    ]


# ---- camera preferences ----------------------------------------------------
#
# Which cameras to hide. Kept apart from config.json so it holds no secret
# and can be edited, synced or shared freely. Cameras are keyed by MAC, so a
# hidden camera stays hidden when it moves to another console.

PREFS_PATH = os.path.join(CONFIG_DIR, "cameras.json")


def load_prefs():
    try:
        with open(PREFS_PATH) as handle:
            prefs = json.load(handle)
    except (OSError, ValueError):
        prefs = {}
    return {"hideOffline": bool(prefs.get("hideOffline", False)),
            "hidden": list(prefs.get("hidden", [])),
            "readOnly": bool(prefs.get("readOnly", False)),
            "favorite": str(prefs.get("favorite") or ""),
            # Armed cameras: camera key (MAC) -> list of triggers.
            "alerts": {str(k): [t for t in v if t in ALERT_TRIGGERS]
                       for k, v in dict(prefs.get("alerts") or {}).items()},
            "notify": bool(prefs.get("notify", True))}


def save_prefs(prefs):
    write_atomic(PREFS_PATH, json.dumps(prefs, indent=2) + "\n", mode=0o644)


def camera_key(camera):
    return camera.get("mac") or camera.get("uid")


def demo_arming(cameras):
    """In demo mode, show a couple of cameras as armed without touching prefs."""
    if demo_on():
        for camera in cameras:
            if camera["name"] in DEMO_ARMED and not camera.get("alerts"):
                camera["alerts"] = list(DEFAULT_TRIGGERS)
    return cameras


def apply_prefs(cameras, prefs):
    hidden = set(prefs.get("hidden", []))
    favorite = prefs.get("favorite", "")
    for camera in cameras:
        camera["hidden"] = camera_key(camera) in hidden
        camera["favorite"] = bool(favorite) and camera_key(camera) == favorite
        camera["alerts"] = list(prefs.get("alerts", {}).get(camera_key(camera), []))
    # The favourite leads the grid and the keyboard order.
    cameras.sort(key=lambda c: not c["favorite"])
    return cameras


def find_cameras(cameras, wanted):
    """Match by uid, camera id, MAC, or name (case-insensitive)."""
    wanted_l = wanted.lower()
    exact = [c for c in cameras if wanted in (c.get("uid"), c.get("id"))
             or wanted_l.replace(":", "") == c.get("mac")]
    if exact:
        return exact
    return [c for c in cameras if c.get("name", "").lower() == wanted_l]


def merge_cameras(cameras):
    """Drop stale copies of a camera that moved between consoles.

    A camera moved from a gateway to an NVR stays listed on the gateway as
    DISCONNECTED. Keep one entry per MAC, preferring a connected one, so the
    ghost never hides the live copy.
    """
    best = {}
    order = []
    for camera in cameras:
        key = camera["mac"] or camera["uid"]
        if key not in best:
            best[key] = camera
            order.append(key)
        elif camera["online"] and not best[key]["online"]:
            best[key] = camera
    return sorted((best[k] for k in order), key=lambda c: (c["consoleName"].lower(), c["name"].lower()))


# ---- state ---------------------------------------------------------------


def previous_state():
    try:
        with open(STATE_PATH) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def fetch_console(console, config):
    try:
        listed = (summarize_camera(c, console) for c in Protect(console, config).cameras())
        cameras = [c for c in listed if c is not None]
        return {"cameras": cameras, "error": None}
    except ProtectError as error:
        return {"cameras": None, "error": str(error)}


def poll_cameras(config=None):
    """Refresh state.json from every console. Never raises.

    Consoles are polled in parallel, so a slow or dead one cannot hold up the
    others; its cameras keep their last known entries, marked stale.
    """
    now = int(time.time())
    try:
        config = config or load_config()
    except ProtectError as error:
        config = None
        load_error = str(error)
    else:
        load_error = None
    if config is None:
        state = {"configured": False, "updatedAt": now, "cameras": [], "consoles": []}
        if load_error:
            state["error"] = load_error
        write_json(STATE_PATH, state)
        return state

    previous = previous_state()
    previous_cameras = previous.get("cameras", [])
    consoles = config["consoles"]
    with ThreadPoolExecutor(max_workers=len(consoles)) as pool:
        results = list(pool.map(lambda c: fetch_console(c, config), consoles))

    cameras = []
    summaries = []
    errors = []
    for console, result in zip(consoles, results):
        stale = result["error"] is not None
        if stale:
            errors.append(f"{console['name']}: {result['error']}")
            listed = [dict(c, online=False, stale=True) for c in previous_cameras
                      if c.get("console") == console["id"]]
        else:
            listed = result["cameras"]
        cameras.extend(listed)
        summaries.append({
            "id": console["id"],
            "name": console["name"],
            "host": console["host"],
            "stale": stale,
            "error": result["error"],
            "cameraCount": len(listed),
            # Signed in for recordings (see `login`).
            "recordings": has_login(console),
        })

    state = {
        "configured": True,
        "host": "  ·  ".join(c["host"] for c in consoles),
        "updatedAt": now,
        "stale": bool(errors),
        "error": "; ".join(errors) if errors else None,
        "consoles": summaries,
        "hideOffline": load_prefs()["hideOffline"],
        "alertNotify": load_prefs()["notify"],
        "cameras": demo_arming(apply_prefs(merge_cameras(cameras), load_prefs())),
    }
    write_json(STATE_PATH, state)
    return state


def snapshot_path(uid):
    return os.path.join(SNAP_DIR, f"{uid}.jpg")


def load_index():
    try:
        with open(SNAP_INDEX) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def refresh_snapshots(config, cameras, index):
    clients = {c["id"]: Protect(c, config) for c in config["consoles"]}

    def grab(camera):
        client = clients.get(camera.get("console"))
        if client is None or not camera.get("online"):
            return None
        try:
            data = client.snapshot(camera["id"])
        except ProtectError:
            return None
        if data:
            write_atomic(snapshot_path(camera["uid"]), data)
            return camera["uid"]
        return None

    # A handful of workers: enough that one slow camera does not stretch
    # the refresh for the rest, few enough not to trip the API rate limit.
    with ThreadPoolExecutor(max_workers=4) as pool:
        for uid in pool.map(grab, cameras):
            if uid:
                index[uid] = time.time()
    write_json(SNAP_INDEX, index)


# ---- commands ------------------------------------------------------------


def verify_console(config, host, pin, key):
    """Prove the key works against the pinned console; (info, cameras)."""
    probe = {"id": "probe", "name": host, "host": host, "apiKey": key, "certSha256": pin}
    client = Protect(probe, config)
    return client.info() or {}, client.cameras()


def default_console_name(config, existing):
    if existing.get("name") and existing.get("name") != existing.get("host"):
        return existing["name"]
    return "NVR" if config["consoles"] and not existing else "Console"


def save_console(config, existing, host, pin, key, name):
    """Add or replace a console and store its key; (entry, "keyring"|"file")."""
    consoles = config["consoles"]
    name = clean_text(name, default_console_name(config, existing), 40)
    taken = {c["id"] for c in consoles if c is not existing}
    console_id = existing.get("id") if existing and existing.get("id") not in taken else slugify(name)
    base, n = console_id, 2
    while console_id in taken:
        console_id, n = f"{base}-{n}", n + 1
    entry = {"id": console_id, "name": name, "host": host, "certSha256": pin}
    if existing and existing.get("id") == console_id:
        # A new key or certificate keeps the recordings login.
        entry.update({k: existing[k] for k in ("loginUser", "loginStore", "loginPassword") if k in existing})
    elif existing:
        clear_login(existing)
    if existing and existing.get("keyStore") == "keyring" and existing.get("id") != console_id:
        keyring_clear(existing["id"])
    where = store_key(config, entry, key)
    if existing:
        consoles[consoles.index(existing)] = entry
    else:
        consoles.append(entry)
    save_config(config)
    return entry, where


def normalize_host(host):
    return host.strip().removeprefix("https://").removeprefix("http://").rstrip("/")


def cmd_setup_probe(args):
    """Panel setup, step 1: reach the console and report its certificate."""
    host = normalize_host(args.host)
    if not host:
        raise ProtectError("enter the console's address")
    try:
        pin = fetch_cert_fingerprint(host)
    except OSError as error:
        raise ProtectError(f"cannot reach {host}: {error.strerror or error}")
    config = load_config() or {"consoles": []}
    existing = next((c for c in config["consoles"] if c["host"] == host), {})
    print(json.dumps({
        "host": host,
        "fingerprint": pin,
        "existing": bool(existing),
        "changed": bool(existing.get("certSha256")) and existing["certSha256"] != pin,
        "suggestedName": default_console_name(config, existing),
    }))


def cmd_setup_save(args):
    """Panel setup, step 2: verify the key and save the console.

    The key arrives on stdin, never as an argument: command lines are
    readable by every local user. An empty key keeps an existing console's
    key (to rename it or re-pin its certificate).
    """
    key = sys.stdin.readline().strip()
    host = normalize_host(args.host)
    config = load_config() or {"consoles": [], "timeoutSec": 8}
    existing = next((c for c in config["consoles"] if c["host"] == host), {})
    if not key:
        key = existing.get("apiKey", "")
    if not key:
        raise ProtectError("paste the API key")
    # The pin was shown to the user in step 1; refuse if the console now
    # presents anything else.
    _, cameras = verify_console(config, host, args.pin, key)
    entry, where = save_console(config, existing, host, args.pin, key, args.name or "")
    poll_cameras(config)
    print(json.dumps({
        "name": entry["name"],
        "cameras": len(cameras),
        "online": sum(1 for c in cameras if c.get("state") == "CONNECTED"),
        "keyStore": where,
    }))


def cmd_setup(args):
    config = load_config() or {"consoles": [], "timeoutSec": 8}
    consoles = config["consoles"]
    print("UniFi Protect setup\n")
    if consoles:
        print("Configured consoles:")
        for console in consoles:
            print(f"  {console['name']}  ({console['host']})")
        print("\nEnter a new address to add a console, or an existing one to replace its key.\n")

    default_host = "" if consoles else "192.168.1.1"
    prompt = f"Console address [{default_host}]: " if default_host else "Console address: "
    host = input(prompt).strip() or default_host
    host = host.removeprefix("https://").removeprefix("http://").rstrip("/")
    if not host:
        raise ProtectError("no address given")
    existing = next((c for c in consoles if c["host"] == host), {})

    try:
        pin = fetch_cert_fingerprint(host)
    except OSError as error:
        raise ProtectError(f"cannot reach {host}: {error}")
    print(f"\nConsole certificate SHA-256:\n  {pin}")
    if existing.get("certSha256") and existing["certSha256"] != pin:
        print("  (this differs from the certificate pinned previously)")
    if input("Trust this certificate? [Y/n] ").strip().lower() not in ("", "y", "yes"):
        raise ProtectError("setup cancelled")

    print(
        "\nCreate an API key on this console itself (the route known to work):\n"
        f"  1. Open https://{host} in a browser and sign in.\n"
        "  2. Click Integrations in the left sidebar (at the bottom of the icon bar).\n"
        "     On older UniFi OS: Settings → scroll the tabs sideways → Integrations.\n"
        "  3. Create API Key. It is shown once; copy it before closing the dialog.\n"
        "Each console needs its own key: a gateway's key does not work on an NVR.\n"
        "If a key made in Site Manager (unifi.ui.com) is rejected, use one made here.\n"
    )
    key = getpass.getpass("API key (input hidden, paste with Super+V): ").strip()
    if not key and existing.get("apiKey"):
        key = existing["apiKey"]
        print("  keeping the existing key")
    if not key:
        raise ProtectError("no API key given")

    info, cameras = verify_console(config, host, pin, key)
    online = sum(1 for c in cameras if c.get("state") == "CONNECTED")
    print(
        f"\nConnected to UniFi Protect {info.get('applicationVersion', '')}".rstrip()
        + f" · {online}/{len(cameras)} camera(s) online"
    )

    default_name = existing.get("name") or ("NVR" if consoles else "Console")
    if existing.get("name") == host:
        default_name = "Console"
    name = input(f"Name for this console [{default_name}]: ").strip() or default_name
    _, where = save_console(config, existing, host, pin, key, name)
    if where == "keyring":
        print(f"API key saved in your keyring; console settings in {CONFIG_PATH}")
    else:
        print(f"No keyring available: API key saved in {CONFIG_PATH} (readable only by you)")
    poll_cameras(config)
    if len(consoles) == 1:
        print("Got another console, such as an NVR? Run `eld-unifi-protect setup` again to add it.")
    print("Click the camera icon in the bar to see your cameras.")


def cmd_consoles(args):
    config = require_config()
    state = {c["id"]: c for c in previous_state().get("consoles", [])}
    for console in config["consoles"]:
        seen = state.get(console["id"], {})
        status = "unreachable" if seen.get("stale") else f"{seen.get('cameraCount', '?')} cameras"
        print(f"{console['id']:<16} {console['name']:<20} {console['host']:<20} {status}")


def cmd_remove(args):
    config = require_config()
    console = find_console(config, args.console)
    if not args.yes and input(f"Remove {console['name']} ({console['host']})? [y/N] ").strip().lower() not in ("y", "yes"):
        raise ProtectError("not changed")
    config["consoles"].remove(console)
    clear_login(console)
    forget_recordings(console["id"])
    if console.get("keyStore") == "keyring":
        try:
            keyring_clear(console["id"])
        except KeyringUnavailable as error:
            print(f"Could not remove the key from the keyring: {error}", file=sys.stderr)
    if config["consoles"]:
        save_config(config)
    else:
        os.remove(CONFIG_PATH)
    # Drop its cameras from the panel now rather than on the next poll.
    state = previous_state()
    state["cameras"] = [c for c in state.get("cameras", []) if c.get("console") != console["id"]]
    write_json(STATE_PATH, state)
    poll_cameras()
    print(f"Removed {console['name']}. Revoke its API key on the console as well.")


def cmd_migrate_keys(args):
    """Move API keys between the keyring and config.json."""
    config = require_config()
    for console in config["consoles"]:
        if console.get("keyError"):
            raise ProtectError(f"{console['name']}: {console['keyError']}")
    if args.to == "keyring" and not keyring_available():
        raise ProtectError("no keyring available (Secret Service via secret-tool)")
    moved = 0
    for console in config["consoles"]:
        in_keyring = console.get("keyStore") == "keyring"
        if args.to == "keyring" and not in_keyring:
            store_key(config, console, console["apiKey"])
            moved += 1
        elif args.to == "file" and in_keyring:
            keyring_clear(console["id"])
            console.pop("keyStore", None)
            moved += 1
    save_config(config)
    where = "your keyring" if args.to == "keyring" else CONFIG_PATH
    print(f"{moved} key(s) moved; all keys are now in {where}")


def camera_uid(wanted):
    """A camera's uid from its uid, id, MAC or name, online ones first."""
    found = find_cameras(previous_state().get("cameras", []), wanted)
    found.sort(key=lambda c: not c.get("online"))
    if found:
        return found[0]["uid"]
    if "_" in wanted:
        return wanted
    raise ProtectError(f"no camera {wanted!r}; see `eld-unifi-protect cameras`")


def cmd_login(args):
    """Sign in to a console's recordings with a local UniFi account.

    Interactive by default. --stdin (used by the panel) reads the username
    and the password as two lines, so the password is never an argument.
    """
    config = require_config()
    console = find_console(config, args.console)
    if console.get("demo"):
        raise ProtectError("demo consoles need no login")
    if args.stdin:
        user = sys.stdin.readline().strip()
        password = sys.stdin.readline().rstrip("\n")
    else:
        print(f"Recordings on {console['name']} need a local UniFi account; API keys can't fetch them.\n"
              f"Create one at https://{console['host']} → Admins & Users → Add: tick "
              "\"Restrict to local access only\" and give it a view-only Protect role.")
        user = input("Username: ").strip()
        password = getpass.getpass("Password: ")
    if not user or not password:
        raise ProtectError("enter the username and the password")
    previous = {k: console[k] for k in ("loginUser", "loginStore", "loginPassword") if k in console}
    console.pop("loginStore", None)
    console.update(loginUser=user, loginPassword=password)
    forget_session(console["id"])
    try:
        # Prove it before saving: sign in and list one event.
        now = time.time()
        ProtectSession(console, config).events(None, now - 3600, now, limit=1)
    except ProtectError:
        for field in ("loginUser", "loginPassword"):
            console.pop(field, None)
        console.update(previous)
        # The trial sign-in may have saved a session for the rejected account.
        forget_session(console["id"])
        raise
    where = store_login(console, user, password)
    save_config(config)
    poll_cameras(config)
    if args.json:
        print(json.dumps({"console": console["id"], "name": console["name"], "store": where}))
    else:
        print(f"Signed in to {console['name']} as {user}; password stored in "
              + ("your keyring." if where == "keyring" else f"{CONFIG_PATH}."))


def forget_recordings(console_id):
    """Delete what was fetched from a console; clips are not labelled by console."""
    shutil.rmtree(CLIPS_DIR, ignore_errors=True)
    for name in os.listdir(RECORDINGS_DIR) if os.path.isdir(RECORDINGS_DIR) else []:
        if name.startswith(console_id + "_"):
            shutil.rmtree(os.path.join(RECORDINGS_DIR, name), ignore_errors=True)


def cmd_logout(args):
    config = require_config()
    console = find_console(config, args.console)
    if not console.get("loginUser"):
        print(f"No recordings login stored for {console['name']}.")
        return
    clear_login(console)
    save_config(config)
    forget_recordings(console["id"])
    poll_cameras(config)
    print(f"Signed out of {console['name']}; its login and fetched recordings are removed.")


def cmd_recordings(args):
    config = require_config()
    uid = camera_uid(args.camera)
    result = recordings_for(config, uid, hours=args.hours, motion=args.motion)
    if args.json:
        print(json.dumps(result))
        return
    if result.get("needsLogin"):
        raise ProtectError(f"no login for recordings on {result['consoleName']}; "
                           f"run `eld-unifi-protect login {result['console']}`")
    for event in result["events"]:
        length = f"{round(event['end'] - event['start'])} s" if event["end"] else "ongoing"
        print(f"{time.strftime('%Y-%m-%d %H:%M:%S', time.localtime(event['start']))}  "
              f"{event['kind']:<10} {length:>8}  --start {event['start']:.3f}"
              + (f" --end {event['end']:.3f}" if event["end"] else ""))


def cmd_clip(args):
    # The panel stops a download it no longer wants with SIGTERM; exit through
    # the finally blocks so the half-written file goes too.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    config = require_config()
    uid = camera_uid(args.camera)
    clip = fetch_clip(config, uid, args.start, args.end, args.quality)
    if args.output:
        shutil.copyfile(clip["path"], args.output)
        clip["path"] = args.output
    if args.play:
        player = shutil.which("mpv")
        if not player:
            raise ProtectError("mpv is not installed: omarchy pkg add mpv")
        title = (args.title or camera_name(uid)) + " · " + time.strftime(
            "%H:%M:%S", time.localtime(args.start))
        exec_mpv(player, mpv_clip_command(player, args.sound == "on"), title, os.path.abspath(clip["path"]))
    print(json.dumps(clip) if args.json else clip["path"])


def cmd_trust_cert(args):
    config = require_config()
    targets = [find_console(config, args.console)] if args.console else config["consoles"]
    changed = False
    for console in targets:
        pin = fetch_cert_fingerprint(console["host"])
        print(f"{console['name']} ({console['host']})\n  pinned:  {console.get('certSha256')}\n  current: {pin}")
        if pin == console.get("certSha256"):
            print("  already trusted")
            continue
        if args.yes or input("  Trust the current certificate? [y/N] ").strip().lower() in ("y", "yes"):
            console["certSha256"] = pin
            changed = True
    if changed:
        save_config(config)
        print("Updated.")


def cmd_poll(args):
    state = poll_cameras()
    if args.print:
        print(json.dumps(state, indent=2))


def cmd_cameras(args):
    state = poll_cameras(require_config())
    for console in state.get("consoles", []):
        if console.get("error"):
            print(f"! {console['name']}: {console['error']}", file=sys.stderr)
    for camera in state["cameras"]:
        status = "online " if camera["online"] else "OFFLINE"
        status += " hidden" if camera.get("hidden") else "       "
        print(f"{status}  {camera['uid']:<40} {camera['consoleName']:<12} {camera['name']}  ({camera['model']})")


def cmd_snapshot(args):
    client, camera_id = resolve_camera(require_config(), args.camera)
    data = client.snapshot(camera_id, high_quality=args.high)
    out = args.output or snapshot_path(args.camera)
    write_atomic(out, data, mode=0o600)
    print(out)


def cmd_watch(args):
    """Snapshot loop the panel runs while it is open.

    Exits on its own when its parent (the shell) goes away, so a crashed or
    restarted shell can never leave it hammering the consoles.
    """
    parent = os.getppid()
    interval = max(1.0, args.interval)
    index = load_index()
    last_poll = 0.0
    cameras = previous_state().get("cameras", [])
    while os.getppid() == parent:
        started = time.monotonic()
        try:
            config = load_config()
            if config is None:
                poll_cameras()
                time.sleep(10)
                continue
            if started - last_poll > 60 or not cameras:
                cameras = poll_cameras(config).get("cameras", [])
                last_poll = started
            refresh_snapshots(config, cameras, index)
        except ProtectError:
            pass
        time.sleep(max(0.2, interval - (time.monotonic() - started)))


def cmd_stream(args):
    client, camera_id = resolve_camera(require_config(), args.camera)
    print(client.stream_url(camera_id, args.quality))


def mpv_command(player, sound=True):
    """The mpv command line for one camera; the URL and title come on stdin."""
    input_conf = os.path.join(PLUGIN_DIR, "mpv", "input.conf")
    return [
        player,
        "--no-terminal",
        # Scroll to zoom, Ctrl+arrows to pan, Ctrl+0 to reset; mpv's own
        # bindings (f for fullscreen, m for mute, q to quit) still apply.
        f"--input-conf={input_conf}",
        # A camera stream that drops (Wi-Fi, firmware update, console
        # restart) ends the "file"; looping it reconnects instead of closing.
        "--loop-file=inf",
        "--title=${media-title}",
        "--force-window=immediate",
        "--profile=low-latency",
        "--untimed",
        "--cache=no",
        "--rtsp-transport=tcp",
        # mpv decodes on the CPU unless told otherwise; a 4K stream costs
        # roughly a third of a core that way, against a few percent on the GPU.
        "--hwdec=auto-safe",
        # One camera on its own: sound on unless asked otherwise (m toggles).
        f"--mute={'no' if sound else 'yes'}",
        "--keep-open=no",
        "--x11-name=eld-unifi-protect",
        "--wayland-app-id=eld-unifi-protect",
        # The URL carries the relay token, and the title names the camera.
        # Command lines are readable by every local user through
        # /proc/<pid>/cmdline, so both go to mpv as a playlist on stdin.
        "--playlist=-",
    ]


def camera_name(uid):
    """A camera's name from the last camera list, for window titles."""
    for camera in previous_state().get("cameras", []):
        if camera.get("uid") == uid or camera.get("id") == uid:
            return camera.get("name") or "UniFi Protect"
    return "UniFi Protect"


def mpv_playlist(title, target):
    """A one-entry M3U playlist: the title (mpv's media-title), then target."""
    title = " ".join(str(title).split()) or "UniFi Protect"
    if "\n" in target or "\r" in target or target.startswith("#"):
        raise ProtectError("unexpected media location")
    return f"#EXTM3U\n#EXTINF:-1,{title}\n{target}\n".encode()


def exec_mpv(player, command, title, target):
    """Replace this process with mpv, playing target under title.

    Both travel as a playlist on stdin, where no other user can read them;
    mpv's window title is ${media-title}, which the playlist sets.
    """
    playlist = mpv_playlist(title, target)
    read_fd, write_fd = os.pipe()
    os.write(write_fd, playlist)
    os.close(write_fd)
    os.dup2(read_fd, 0)
    os.close(read_fd)
    os.execv(player, command)


def cmd_live(args):
    client, camera_id = resolve_camera(require_config(), args.camera)
    url = client.stream_url(camera_id, args.quality)
    player = shutil.which("mpv")
    if not player:
        raise ProtectError("mpv is not installed: omarchy pkg add mpv")
    title = args.title or camera_name(args.camera)
    exec_mpv(player, mpv_command(player, args.sound == "on"), title, url)


def cmd_open(args):
    config = require_config()
    console = find_console(config, args.console) if args.console else config["consoles"][0]
    subprocess.Popen(
        ["xdg-open", f"https://{console['host']}/protect/dashboard"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def cmd_doctor(args):
    ok = True

    def report(good, label, detail=""):
        nonlocal ok
        ok = ok and good
        print(("  ok   " if good else "  FAIL ") + label + (f" — {detail}" if detail else ""))

    config = load_config()
    report(config is not None, "config", CONFIG_PATH if config else "run `eld-unifi-protect setup`")
    report(shutil.which("mpv") is not None, "mpv installed (pop-out player)")
    for console in (config or {}).get("consoles", []):
        print(f"\n{console['name']} ({console['host']})")
        store = "keyring" if console.get("keyStore") == "keyring" else f"file ({CONFIG_PATH})"
        report(not console.get("keyError"), "API key stored in " + store, console.get("keyError", ""))
        try:
            pin = fetch_cert_fingerprint(console["host"])
            report(pin == console.get("certSha256"), "certificate matches pin")
        except OSError as error:
            report(False, "console reachable", str(error))
            continue
        try:
            client = Protect(console, config)
            info = client.info() or {}
            report(True, "API key accepted", "Protect " + str(info.get("applicationVersion", "?")))
            cameras = client.cameras()
            online = sum(1 for c in cameras if c.get("state") == "CONNECTED")
            report(True, "cameras", f"{online}/{len(cameras)} online")
        except ProtectError as error:
            report(False, "API", str(error))
        if console.get("loginUser"):
            try:
                now = time.time()
                ProtectSession(console, config).events(None, now - 3600, now, limit=1)
                report(True, "recordings login", console["loginUser"])
            except (ProtectError, KeyringUnavailable) as error:
                report(False, "recordings login", str(error))
        else:
            print("  --   recordings: no login (optional; `eld-unifi-protect login`)")
    sys.exit(0 if ok else 1)


def cmd_hide(args, hide=True):
    state = poll_cameras(require_config())
    prefs = load_prefs()
    hidden = set(prefs["hidden"])
    for wanted in args.cameras:
        matches = find_cameras(state["cameras"], wanted)
        if not matches:
            raise ProtectError(f"no camera {wanted!r}; see `eld-unifi-protect cameras`")
        for camera in matches:
            (hidden.add if hide else hidden.discard)(camera_key(camera))
            print(("hidden   " if hide else "visible  ") + camera["name"] + "  ·  " + camera["consoleName"])
    prefs["hidden"] = sorted(hidden)
    save_prefs(prefs)
    poll_cameras()


def cmd_unhide(args):
    if args.all:
        prefs = load_prefs()
        prefs["hidden"] = []
        save_prefs(prefs)
        poll_cameras()
        print("all cameras visible")
        return
    if not args.cameras:
        raise ProtectError("name a camera, or pass --all")
    cmd_hide(args, hide=False)


def cmd_read_only(args):
    prefs = load_prefs()
    if args.mode != "status":
        prefs["readOnly"] = args.mode == "on"
        save_prefs(prefs)
        # Cached URLs may include fallbacks chosen under the other setting.
        try:
            os.remove(STREAM_CACHE)
        except FileNotFoundError:
            pass
    if prefs["readOnly"]:
        print("read-only: on; only streams already enabled in Protect are used")
    else:
        print("read-only: off; the plugin enables a camera's stream when one is needed")


def cmd_favorite(args):
    prefs = load_prefs()
    if args.clear or not args.camera:
        prefs["favorite"] = ""
        save_prefs(prefs)
        poll_cameras()
        print("no favourite camera")
        return
    state = poll_cameras(require_config())
    matches = find_cameras(state["cameras"], args.camera)
    if len(matches) != 1:
        raise ProtectError(f"{args.camera!r} matches {len(matches)} cameras; use its id "
                           "from `eld-unifi-protect cameras`")
    prefs["favorite"] = camera_key(matches[0])
    save_prefs(prefs)
    poll_cameras()
    print(f"favourite: {matches[0]['name']}  ·  {matches[0]['consoleName']}")


def cmd_hide_offline(args):
    prefs = load_prefs()
    if args.mode == "toggle":
        prefs["hideOffline"] = not prefs["hideOffline"]
    else:
        prefs["hideOffline"] = args.mode == "on"
    save_prefs(prefs)
    poll_cameras()
    print("offline cameras " + ("hidden" if prefs["hideOffline"] else "shown"))


WALL_DIR = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "wall")
WALL_CONFIG = os.path.join(RUNTIME_DIR, "wall.json")
WALL_PID = os.path.join(RUNTIME_DIR, "wall.pid")


def running_wall():
    try:
        with open(WALL_PID) as handle:
            pid = int(handle.read().strip())
        with open(f"/proc/{pid}/cmdline", "rb") as handle:
            if b"quickshell" in handle.read():
                return pid
    except (OSError, ValueError):
        pass
    return None


# The wall window's title, matched by the Hyprland rule below. wall/shell.qml
# sets the same title; keep the two in step.
WALL_WINDOW_TITLE = "UniFi Protect Wall"


def register_wall_window_rule():
    """Ask Hyprland to maximize the wall window when it opens.

    A rule that matches only the wall's title, registered at runtime: it
    never touches another window and writes nothing to the user's config.
    It is registered once per Hyprland session and remembered in a Lua
    global, because registering it again on every launch disabled it.
    Reloading the config clears both, so the next launch registers it anew.
    Best effort: without Hyprland, or with an older one, the wall still
    opens, just not maximized.
    """
    rule = (
        "if not _G.eld_unifi_protect_wall_rule then "
        "_G.eld_unifi_protect_wall_rule = hl.window_rule({ "
        f"match = {{ title = '^{WALL_WINDOW_TITLE}$' }}, maximize = true }}) "
        "end"
    )
    hyprctl = shutil.which("hyprctl")
    if not hyprctl:
        return
    subprocess.run([hyprctl, "eval", rule], stdout=subprocess.DEVNULL,
                   stderr=subprocess.DEVNULL, timeout=5, check=False)


def cmd_wall(args):
    """Fullscreen live grid of every online camera, in its own process.

    Running it again while it is up closes it, so one keybinding toggles it.
    """
    pid = running_wall()
    if pid:
        if args.no_toggle:
            return
        os.kill(pid, signal.SIGTERM)
        return

    config = require_config()
    state = poll_cameras(config)
    cameras = [c for c in state.get("cameras", []) if c.get("online") and not c.get("hidden")]
    if not cameras:
        raise ProtectError("no cameras online")
    clients = {c["id"]: Protect(c, config) for c in config["consoles"]}
    qualities = list(dict.fromkeys([args.quality, args.focus_quality]))

    def resolve(camera):
        try:
            urls = clients[camera["console"]].stream_urls(camera["id"], qualities)
            return dict(camera, grid=urls[args.quality], focus=urls[args.focus_quality])
        except (ProtectError, KeyError) as error:
            return dict(camera, error=str(error))

    with ThreadPoolExecutor(max_workers=2) as pool:
        tiles = list(pool.map(resolve, cameras))

    # The URLs embed per-camera access tokens: keep the file private.
    write_json(WALL_CONFIG, {
        "cameras": tiles,
        "snapshotDir": SNAP_DIR,
        "multiConsole": len(config["consoles"]) > 1,
        # Sound for an enlarged camera; grid tiles never play any.
        "sound": args.sound == "on",
    })
    quickshell = shutil.which("quickshell") or shutil.which("qs")
    if not quickshell:
        raise ProtectError("quickshell is not installed")
    if args.mode == "window":
        register_wall_window_rule()
    env = dict(os.environ, ELD_UNIFI_PROTECT_WALL=WALL_CONFIG,
               ELD_UNIFI_PROTECT_WALL_MODE=args.mode)
    process = subprocess.Popen(
        [quickshell, "--no-duplicate", "--path", WALL_DIR],
        env=env,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )
    write_atomic(WALL_PID, str(process.pid))


def private_dir_problem(path):
    """Why path is not a private directory of ours, or None if it is."""
    try:
        info = os.lstat(path)
    except OSError as error:
        return f"cannot use {path}: {error.strerror}"
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISDIR(info.st_mode):
        return f"{path} is not a directory"
    if info.st_uid != os.getuid():
        return f"{path} is not owned by you"
    if info.st_mode & 0o077:
        return f"{path} is accessible to other users"
    return None


def check_runtime_dir():
    if not RUNTIME_BASE:
        raise ProtectError("XDG_RUNTIME_DIR is not set; it is needed for a private runtime directory")
    problem = private_dir_problem(RUNTIME_BASE)
    if problem:
        raise ProtectError(problem)
    try:
        os.mkdir(RUNTIME_DIR, 0o700)
    except FileExistsError:
        # Earlier versions let os.makedirs create this as a side effect of a
        # deeper path, with default 0755 permissions. If it is our own real
        # directory, tighten it rather than refuse to run.
        info = os.lstat(RUNTIME_DIR)
        if stat.S_ISDIR(info.st_mode) and info.st_uid == os.getuid():
            os.chmod(RUNTIME_DIR, 0o700)
    problem = private_dir_problem(RUNTIME_DIR)
    if problem:
        raise ProtectError(problem)


def main():
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    parser = argparse.ArgumentParser(prog="eld-unifi-protect", description=__doc__.splitlines()[0])
    parser.add_argument("--version", action="version", version=f"%(prog)s {plugin_version()}")
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("setup", help="add a console, or replace a console's key").set_defaults(func=cmd_setup)
    sub.add_parser("consoles", help="list configured consoles").set_defaults(func=cmd_consoles)
    p = sub.add_parser("setup-probe", help=argparse.SUPPRESS)
    p.add_argument("host")
    p.set_defaults(func=cmd_setup_probe)
    p = sub.add_parser("setup-save", help=argparse.SUPPRESS)
    p.add_argument("--host", required=True)
    p.add_argument("--pin", required=True)
    p.add_argument("--name")
    p.set_defaults(func=cmd_setup_save)
    p = sub.add_parser("remove", help="remove a console")
    p.add_argument("console", help="console id, name or address")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(func=cmd_remove)
    p = sub.add_parser("migrate-keys", help="move API keys to the keyring, or back to the config file")
    p.add_argument("--to", choices=("keyring", "file"), default="keyring")
    p.set_defaults(func=cmd_migrate_keys)
    p = sub.add_parser("trust-cert", help="re-pin console certificates")
    p.add_argument("console", nargs="?")
    p.add_argument("--yes", action="store_true")
    p.set_defaults(func=cmd_trust_cert)
    p = sub.add_parser("poll", help="refresh the state file")
    p.add_argument("--print", action="store_true")
    p.set_defaults(func=cmd_poll)
    sub.add_parser("cameras", help="list cameras").set_defaults(func=cmd_cameras)
    p = sub.add_parser("snapshot", help="save a camera snapshot")
    p.add_argument("camera")
    p.add_argument("-o", "--output")
    p.add_argument("--high", action="store_true", help="request a full-resolution snapshot")
    p.set_defaults(func=cmd_snapshot)
    p = sub.add_parser("watch", help="refresh snapshots in a loop (used by the panel)")
    p.add_argument("--interval", type=float, default=3)
    p.set_defaults(func=cmd_watch)
    p = sub.add_parser("stream", help="print a camera's RTSPS URL")
    p.add_argument("camera")
    p.add_argument("--quality", choices=QUALITIES, default="medium")
    p.set_defaults(func=cmd_stream)
    p = sub.add_parser("live", help="play a camera in mpv")
    p.add_argument("camera")
    p.add_argument("--quality", choices=QUALITIES, default="high")
    p.add_argument("--title")
    p.add_argument("--sound", choices=("on", "off"), default="on", help="start with sound (default on)")
    p.set_defaults(func=cmd_live)
    p = sub.add_parser("hide", help="hide cameras from the panel and wall")
    p.add_argument("cameras", nargs="+", help="camera name, id or MAC")
    p.set_defaults(func=cmd_hide)
    p = sub.add_parser("unhide", help="show hidden cameras again")
    p.add_argument("cameras", nargs="*")
    p.add_argument("--all", action="store_true")
    p.set_defaults(func=cmd_unhide)
    p = sub.add_parser("read-only", help="never change anything on the consoles (no enabling streams)")
    p.add_argument("mode", choices=("on", "off", "status"), nargs="?", default="status")
    p.set_defaults(func=cmd_read_only)
    p = sub.add_parser("alert", help="arm a camera for alerts, list armed cameras, or --ack")
    p.add_argument("camera", nargs="?")
    p.add_argument("--on", help=f"comma-separated triggers ({', '.join(ALERT_TRIGGERS)}); "
                                f"default {','.join(DEFAULT_TRIGGERS)}")
    p.add_argument("--off", action="store_true", help="disarm the camera")
    p.add_argument("--ack", action="store_true", help="acknowledge all current alerts")
    p.add_argument("--clear", action="store_true", help="clear the alert log")
    p.add_argument("--notify", choices=("on", "off"), help="desktop notifications for alerts")
    p.set_defaults(func=cmd_alert)
    p = sub.add_parser("events", help="listen for alerts on armed cameras (started by the panel)")
    p.add_argument("--follow-parent", action="store_true", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_events)
    p = sub.add_parser("login", help="sign in to a console's recordings with a local UniFi account")
    p.add_argument("console", nargs="?")
    p.add_argument("--stdin", action="store_true", help="read username and password as two lines")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_login)
    p = sub.add_parser("logout", help="remove a console's recordings login")
    p.add_argument("console", nargs="?")
    p.set_defaults(func=cmd_logout)
    p = sub.add_parser("recordings", help="list a camera's recent detections")
    p.add_argument("camera", help="camera uid or name")
    p.add_argument("--hours", type=float, default=24)
    p.add_argument("--motion", action="store_true", help="include plain motion events")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_recordings)
    p = sub.add_parser("clip", help="fetch the recording of an event (see `recordings`)")
    p.add_argument("camera", help="camera uid or name")
    p.add_argument("--start", type=float, required=True, help="event start, Unix seconds")
    p.add_argument("--end", type=float, help="event end; omit for one still in progress")
    p.add_argument("--quality", choices=QUALITIES, default="medium")
    p.add_argument("-o", "--output", help="also save a copy here")
    p.add_argument("--play", action="store_true", help="play it in mpv")
    p.add_argument("--title")
    p.add_argument("--sound", choices=("on", "off"), default="on")
    p.add_argument("--json", action="store_true")
    p.set_defaults(func=cmd_clip)
    p = sub.add_parser("demo", help="made-up cameras for screenshots and trying the plugin")
    p.add_argument("mode", choices=("on", "off", "status"), nargs="?", default="status")
    p.set_defaults(func=cmd_demo)
    p = sub.add_parser("favorite", help="set the camera the panel opens on (or --clear)")
    p.add_argument("camera", nargs="?")
    p.add_argument("--clear", action="store_true")
    p.set_defaults(func=cmd_favorite)
    p = sub.add_parser("hide-offline", help="hide cameras that are offline")
    p.add_argument("mode", choices=("on", "off", "toggle"))
    p.set_defaults(func=cmd_hide_offline)
    sub.add_parser("relay", help="run the encrypted stream relay (started on demand)").set_defaults(func=cmd_relay)
    p = sub.add_parser("wall", help="toggle a live grid of all cameras")
    p.add_argument("--quality", choices=QUALITIES, default="medium", help="stream for grid tiles")
    p.add_argument("--focus-quality", choices=QUALITIES, default="high", help="stream for an enlarged camera")
    p.add_argument("--no-toggle", action="store_true", help="do nothing if already open")
    p.add_argument("--mode", choices=("window", "overlay"), default="window",
                   help="window: maximized, keeps workspaces and the bar (default); "
                        "overlay: covers everything")
    p.add_argument("--sound", choices=("on", "off"), default="on",
                   help="sound for an enlarged camera (default on); tiles are always silent")
    p.set_defaults(func=cmd_wall)
    p = sub.add_parser("open", help="open Protect in the browser")
    p.add_argument("console", nargs="?")
    p.set_defaults(func=cmd_open)
    sub.add_parser("doctor", help="check the setup").set_defaults(func=cmd_doctor)

    args = parser.parse_args()
    try:
        check_runtime_dir()
        args.func(args)
    except ProtectError as error:
        # Messages can quote the console; never let it reach the terminal raw
        # (escape sequences can retitle it or write to the clipboard).
        print(f"eld-unifi-protect: {clean_text(str(error), 'error', 1000)}", file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
