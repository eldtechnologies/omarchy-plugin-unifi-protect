{
  "schemaVersion": 1,
  "id": "com.eldtechnologies.unifi-protect",
  "name": "UniFi Protect",
  "version": "0.4.0",
  "author": "ELD Technologies",
  "license": "MIT",
  "description": "See your UniFi Protect cameras from the Omarchy bar: a snapshot grid, live video in the panel, a fullscreen camera wall, and support for several consoles.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "UniFi Protect",
    "description": "Camera grid and live view for a UniFi Protect console.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "columns": 2,
      "liveQuality": "medium",
      "popoutQuality": "high",
      "wallMode": "window",
      "refresh": "balanced",
      "framing": "fill",
      "openFavoriteLive": false,
      "sound": true
    },
    "schema": [
      {
        "key": "refresh",
        "type": "enum",
        "label": "Snapshot refresh while the panel is open",
        "options": [
          "fast",
          "balanced",
          "efficient"
        ],
        "defaultValue": "balanced"
      },
      {
        "key": "framing",
        "type": "enum",
        "label": "Picture framing (fill crops to the tile, fit shows it all)",
        "options": [
          "fill",
          "fit"
        ],
        "defaultValue": "fill"
      },
      {
        "key": "openFavoriteLive",
        "type": "boolean",
        "label": "Open straight into the favourite camera's live view",
        "defaultValue": false
      },
      {
        "key": "columns",
        "type": "integer",
        "label": "Columns in the camera grid",
        "min": 1,
        "max": 4,
        "step": 1,
        "defaultValue": 2
      },
      {
        "key": "liveQuality",
        "type": "string",
        "label": "In-panel live quality (high, medium, low)",
        "defaultValue": "medium"
      },
      {
        "key": "popoutQuality",
        "type": "string",
        "label": "Pop-out player quality (high, medium, low)",
        "defaultValue": "high"
      },
      {
        "key": "sound",
        "type": "boolean",
        "label": "Sound when one camera is shown (live view, enlarged wall camera, pop-out)",
        "defaultValue": true
      },
      {
        "key": "wallMode",
        "type": "enum",
        "label": "Camera wall",
        "options": [
          "window",
          "overlay"
        ],
        "defaultValue": "window"
      }
    ]
  },
  "homepage": "https://github.com/eldtechnologies/omarchy-plugin-unifi-protect"
}
